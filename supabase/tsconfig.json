{
  // Covers exactly one file: env.ts, the manifest for the variables
  // config.toml reads. This directory is not a workspace package, so the
  // check is invoked from @devdogsuga/supabase's typecheck script
  // (`tsc --noEmit -p ../../supabase`); imports resolve because the ROOT
  // package.json depends on @devdogsuga/env and zod.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The base sets `incremental`, which would strew a tsbuildinfo file into
    // this directory for a single-file --noEmit check. Not worth it.
    "incremental": false
  },
  "include": ["env.ts"]
}
