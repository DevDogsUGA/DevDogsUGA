+// DevDogsUGA TASK-294: Cloudflare workerd implements console.createTask()
+// as a stub that THROWS ERR_METHOD_NOT_IMPLEMENTED instead of being absent,
+// breaking this file's `console.createTask ? ... : ...` feature-detect --
+// and a synchronous probe isn't reliable either (workerd lets the probe
+// succeed outside a request's I/O context, then throws the same call once
+// it runs inside real request handling). Hard-disable specifically when
+// running on Cloudflare Workers (per Cloudflare's documented runtime
+// check), leaving every other runtime's real support intact. File
+// upstream against cloudflare/workerd if this comment outlives the gap.
+function workerdSupportsConsoleCreateTask() {
+  if (
+    typeof navigator !== "undefined" &&
+    navigator.userAgent === "Cloudflare-Workers"
+  )
+    return false;
+  return !!console.createTask;
+}
