       MIN_CHUNK_SIZE = 65536,
-      supportsCreateTask = !!console.createTask,
+      supportsCreateTask = (function () {
+        // Cloudflare workerd (vinext dev, not vinext build) implements
+        // console.createTask() as a stub that THROWS ERR_METHOD_NOT_IMPLEMENTED
+        // rather than being absent, breaking the `!!console.createTask`
+        // feature-detect this file used to use. A synchronous probe here is
+        // NOT reliable either: workerd lets the probe succeed when this module
+        // is first required outside any request's I/O context (e.g. at Worker
+        // cold start / route warm-up), then throws the SAME call once it runs
+        // inside real request handling -- which is exactly when this module's
+        // one-time, cached `supportsCreateTask` value is actually used. So:
+        // hard-disable it specifically when running on Cloudflare Workers
+        // (per Cloudflare's documented runtime check), leaving every other
+        // runtime's real support intact.
+        // See DevDogsUGA TASK-294; file upstream against cloudflare/workerd
+        // if this comment outlives the gap.
+        if (
+          typeof navigator !== "undefined" &&
+          navigator.userAgent === "Cloudflare-Workers"
+        )
+          return false;
+        return !!console.createTask;
+      })(),
       fakeFunctionCache = new Map(),
       fakeFunctionIdx = 0,
       createFakeJSXCallStack = {
