# local env files
# There is a single root .env for the whole monorepo. Never commit any .env
# file (.env, .env.generated, .env.local, ...); only .env.example is tracked.
.env*
!.env.example

# vercel
.vercel

# cloudflare / opennext
.open-next/
**/.open-next/
.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# typescript
*.tsbuildinfo

