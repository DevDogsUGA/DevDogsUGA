# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
 
# dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js

# testing
coverage/

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
.next/
**/.next/
out/
**/out/
next-env.d.ts
**/next-env.d.ts

# production
build/
**/build/
dist/
**/dist/
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# One root env file per environment: .env IS development, and .env.staging /
# .env.production are materialised by `env init` / `env pull`.
# `.env.generated` is the local stack's overlay. None of them may ever be
# committed. The single exception, .env.example, is GENERATED output — run
# `pnpm devtools env example` rather than editing it; CI checks the drift.
.env*
!.env.example

# throwaway spikes
# These carry credentials inline (see scripts/spike/SPIKE-README.md) rather than
# reading from .env, because they are run by hand against throwaway accounts.
# Nothing in here is tracked, so a pasted client secret cannot be committed.
scripts/spike/

# vercel
.vercel

# cloudflare / opennext
.open-next/
**/.open-next/
.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# typescript
*.tsbuildinfo

# supabase
supabase/.*
**/supabase/.*
volumes/
**/volumes/

# ide configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.claude
.idea
.mcp.json

# eslint
/.eslintcache
.idea/inspectionProfiles/Project_Default.xml
.idea/vcs.xml

# drizzle-kit pull byproducts: a fully commented-out "initial migration" plus the
# snapshot that pairs with it. Migrations live in packages/sb/supabase/migrations
# and nothing here runs `drizzle-kit generate`, so nothing diffs against these.
# The sibling schema.ts / relations.ts ARE source and stay tracked.
**/drizzle/*_*/
**/schema/generated/*_*/
drizzle-generated/

branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

# Design-sync bundle output. Regenerated by `format:write`; `**/*.js` in the
# platform's tsconfig include would otherwise typecheck a minified bundle.
ds-bundle/

# generated api reference
# `docs-build gen` derives these from doc comments in the source, 200-plus
# pages of them, and rewrites the lot on every build. Committing them would put
# a regenerated wall of markdown into every review diff that touched a single
# exported symbol, which makes the diff useless for reading the change that
# actually mattered. Nothing is lost by leaving them out: every input the
# generator reads is committed, so any clone can reproduce the output exactly
# by building. The Dart pass is the same deal one step earlier -- the Flutter
# analyzer writes its extraction to tool/*.docs.json, which the generator then
# turns into pages.
docs/*/reference/
apps/study-group-finder/tool/*.docs.json

# Design-sync working state. Local-only by choice: the tool is run from one
# machine, so the whole directory stays out of the repo rather than just its
# build cache. Note what that gives up — a fresh clone cannot re-sync as-is,
# because .design-sync/ holds the only copy of the Claude Design projectId
# (config.json), the 47 authored previews, and the forked prop extractor
# (overrides/dts.mjs). Back it up out-of-band, or drop this entry if a second
# contributor ever needs to run the sync.
.ds-sync/
**/.design-sync/

# `pnpm devtools images` writes event posters here. They are exports headed for
# the GDG platform — one per meeting, made once — rather than the committed
# brand assets the rest of that command renders, so they stay out of the tree.
.images/
