# local env files
# One root env file per environment: .env IS development, and .env.staging /
# .env.production are materialised by `env init` / `env pull`.
# `.env.generated` is the local stack's overlay. None of them may ever be
# committed. The single exception, .env.example, is GENERATED output — run
# `pnpm devtools env example` rather than editing it; CI checks the drift.
.env*
!.env.example

# throwaway spikes
# These carry credentials inline (see scripts/spike/SPIKE-README.md) rather than
# reading from .env, because they are run by hand against throwaway accounts.
# Nothing in here is tracked, so a pasted client secret cannot be committed.
scripts/spike/

# vercel
.vercel

# cloudflare / vinext
.vinext/
**/.vinext/
.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# typescript
*.tsbuildinfo

# supabase
supabase/.*
**/supabase/.*
volumes/
**/volumes/

# ide configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.claude
.idea
.mcp.json
# the Playwright MCP's screenshots, snapshots and console logs
.playwright-mcp/

