{
  "name": "@devdogsuga/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The monorepo's documentation content. Markdown only — the compiler lives in @devdogsuga/docs-compiler.",
  "exports": {
    ".": {
