{
  "$schema": "https://turborepo.com/schema.json",
  // Root-level files that every package's tasks depend on but that live
  // outside any package, so turbo cannot reach them through the task graph:
  // the tsconfig every package extends, and the shared eslint/vitest presets
  // from @devdogsuga/config (which exposes no task of its own to depend on).
  "globalDependencies": [
    "tsconfig.base.json",
    "packages/config/eslint/**",
    "packages/config/tsconfig/**",
    "packages/config/vitest/**"
  ],
  "globalPassThroughEnv": [
    "BASE_URL",
    "SCHEDULE_BUILDER_URL",
    "DEPLOY_ENV",
    "SKIP_ENV_VALIDATION",
    "CI",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `.next/cache` is Next's local incremental-compiler cache: large,
      // machine-specific, and rebuilt on demand. Caching it as a build output
      // bloats the turbo cache without making restores any more correct.
      // `*.tsbuildinfo` must be cached alongside `dist`: tsconfig.base.json
      // sets `incremental`, and the build-info file lives at the package root
      // rather than inside `dist`. If it survives while `dist` does not, tsc
      // considers the output current and emits nothing — the build "succeeds"
      // with no `dist`, and consumers fail to resolve the package's types.
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".open-next/**",
        "dist/**",
        "build/**",
        "*.tsbuildinfo"
      ],
      // BASE_URL, SCHEDULE_BUILDER_URL and DEPLOY_ENV appear here *and* in
      // globalPassThroughEnv above; that pairing is deliberate, not a
      // duplicate. Passthrough makes them readable by every task under strict
      // env mode; listing them here additionally folds them into the build
      // hash, which they need since their values are baked into the output.
      "env": [
        "BASE_URL",
        "SCHEDULE_BUILDER_URL",
        "DEPLOY_ENV",
        "CRON_SECRET",
        "DEVDOGS_EPOCH",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_ORG",
        "GITHUB_TOKEN",
        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET",
        "DISCORD_GUILD_ID",
        "DISCORD_PUBLIC_KEY",
        "DISCORD_TOKEN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "S3_PORT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "SHARED_AUTH_CLIENT_ID",
        "SHARED_AUTH_CLIENT_SECRET",
        "NEXT_PUBLIC_AUTH_MODE"
      ]
    },
    // @devdogsuga/email generates `src/generated/templates.ts` during its own
    // build — the compiled chunk arrays and the prop types derived from each
    // template's `Props`. It is gitignored, because a committed copy would win
    // silently over an out-of-date rebuild. That makes it the one package
    // whose typecheck and tests need its OWN build, not just its
    // dependencies': on a clean checkout the file does not exist yet.
    "@devdogsuga/email#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**", "*.tsbuildinfo"]
    },
    "@devdogsuga/email#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@devdogsuga/email#test": {
      "dependsOn": ["^build", "build"]
    },
    // `^build` so workspace deps that emit (notably @devdogsuga/docs, whose
    // build parses docs/**/*.md into the module the docs routes import) exist
    // before the dev server starts. `turbo watch dev` then re-runs those builds
    // on change; for docs authoring prefer the lighter
    // `pnpm dev:docs` watcher alongside `pnpm dev`, which lets Turbopack HMR the
    // regenerated module instead of restarting Next.
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // The shared eslint config is type-aware (recommendedTypeChecked +
    // projectService), so linting resolves types across package boundaries.
    // Without the workspace deps' `dist/*.d.ts` on disk those types collapse
    // to `any` and the no-unsafe-* rules fire in the hundreds — so lint needs
    // its dependencies built, exactly like typecheck does.
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "generate-types": {
      "cache": false
    }
  }
}
