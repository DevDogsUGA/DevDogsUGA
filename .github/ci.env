# Synthetic environment for the `database` job's build step. NOT SECRET, and
# nothing here reaches a real service.
#
# Named `ci.env` rather than `.env.ci` on purpose: .gitignore excludes `.env*`
# with a single exception for `.env.example`, so anything matching that pattern
# cannot be committed. The workflow copies this to `.env`, where `with-env`
# expects it.
#
# WHY A BUILD NEEDS AN ENVIRONMENT AT ALL, given SKIP_ENV_VALIDATION exists:
# that flag skips *validation*, not *reading*. `next.config.ts:33` evaluates
#
#   new URL("/storage/v1/object/public/**", env.NEXT_PUBLIC_SUPABASE_URL)
#
# and an undefined base throws `ERR_INVALID_URL` before any page is rendered.
# Skipping validation moves the failure; it does not remove the requirement.
#
# So the build step runs with validation ENFORCED (`SKIP_ENV_VALIDATION: ""`),
# which buys something the rest of CI cannot check: a newly added required
# variable with no default fails the build here rather than at deploy time.
#
# The Supabase half is NOT here -- it comes from `.env.generated`, written by
# `supabase start` in the same job, so the build renders against a real Postgres
# and a real PostgREST. Only the values below are invented, and they are the
# ones nothing reads during a build: no page fetches Discord or GitHub while
# prerendering.

# Third-party APIs. Deliberately obvious placeholders -- if one of these ever
# appears in a request, the failure should read as a misconfiguration and not as
# an authentication error.
DISCORD_GUILD_ID="000000000000000000"
DISCORD_PUBLIC_KEY="ci-not-a-real-key"
DISCORD_TOKEN="ci-not-a-real-token"
# Empty on purpose: nothing in CI should be able to post to Discord.
DISCORD_ALERT_CHANNEL_ID=""
GITHUB_ORG="DevDogsUGA"
# Shape-valid and functionally dead. CI type-checks and builds; it never calls
# GitHub as the App, so a real key here would be a credential with no purpose.
GH_APP_ID="1"
GH_APP_INSTALLATION_ID="1"
GH_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER-NOT-A-REAL-KEY-see-docs-platform-env-md\n-----END RSA PRIVATE KEY-----\n"

# Storage bucket names, created by `seed-buckets:local` during `supabase start`.
# Real values, because the build resolves image URLs against them.
NEXT_PUBLIC_AVATARS_BUCKET="avatars"
NEXT_PUBLIC_FEEDBACK_BUCKET="feedback-attachments"

# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are appended
# by the workflow from `.env.generated` rather than hardcoded here. They must
# match the stack the build renders against, and the CLI's local keys are not
# guaranteed stable across versions.
