{
  "name": "devdogs-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "devtools": "pnpm --config.ignore-scripts=true dlx @devdogsuga/devtools@next",
    "backstage": "pnpm --config.ignore-scripts=true dlx @devdogsuga/backstage@next",
    "dev": "echo 'Start one app: pnpm -F <app> dev, or cd apps/<app> && pnpm dev (apps: platform, catalog, slides)'",
    "build": "pnpm -r --filter '!slides' --if-present run build",
    "build:slides": "pnpm --filter slides build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --no-bail --if-present run lint",
    "lint:fix": "pnpm -r --no-bail --if-present run lint:fix",
    "test": "pnpm -r --if-present run test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,jsx,md,mdx,json,css}\" --cache --ignore-path .gitignore --ignore-path .prettierignore",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,jsx,md,mdx,json,css}\" --cache --ignore-path .gitignore --ignore-path .prettierignore",
    "check:scripts": "node --test scripts/check-scripts.test.mjs scripts/deprecate-old-packages.test.mjs scripts/archive-teams-and-competitions.test.ts",
    "check:publish": "node --test scripts/publish-changed-packages.test.mjs scripts/publish-next.test.mjs scripts/dart-next-tag.test.mjs scripts/workflow-permissions.test.mjs",
    "check:patches": "node scripts/patch-audit.ts",
    "populate:patch-issues": "node scripts/patch-issues.ts",
    "test:patches": "node --test scripts/patch-audit.test.ts scripts/patch-issues.test.ts",
    "test:deploy": "node --test \".github/scripts/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@devdogsuga/devtools": "workspace:*",
    "@devdogsuga/sdk": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devdogs": {
    "scriptExceptions": {
      "root#devtools": "run the published contributor CLI (pnpm dlx, the newest prerelease on the next tag: this checkout needs the sdk-era CLI, which the stable latest tag lacks until the Gate)",
      "root#backstage": "run the published officer CLI (pnpm dlx, always the latest publish)",
      "root#build:slides": "builds the slides app only (CI builds it separately)",
      "slides#follow": "run a deck on a demo laptop",
      "slides#export:md": "export a deck to docs pages",
      "slides#tag-steps": "tag workshop repo steps from a deck",
      "slides#dev:worker": "run the slides Worker locally",
      "slides#deploy": "deploy the slides Worker",
      "workshops#watch": "rebuild the VS Code extension on change",
      "workshops#package": "package the VS Code extension (.vsix)",
      "@devdogsuga/devtools#cli": "run the built devtools CLI from the source tree",
      "@devdogsuga/backstage#cli": "run the built backstage CLI from the source tree"
    }
  }
}
