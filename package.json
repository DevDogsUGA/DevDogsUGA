{
  "name": "devdogs-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "devtools": "pnpm --config.ignore-scripts=true dlx @devdogsuga/devtools",
    "build": "pnpm devtools run build",
    "dev": "pnpm devtools run dev",
    "typecheck": "pnpm devtools run typecheck",
    "lint": "pnpm devtools run lint",
    "lint:fix": "pnpm devtools run lint:fix",
    "test": "pnpm devtools run test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx,json,css}\" --cache --ignore-path .gitignore --ignore-path .prettierignore",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx,json,css}\" --cache --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@devdogsuga/config": "^0.1.1",
    "@devdogsuga/devtools": "0.1.13",
    "@devdogsuga/env": "^0.1.2",
    "@types/node": "catalog:",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@11.8.0"
}
