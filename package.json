{
  "name": "devdogs-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/pick.mjs build",
    "dev": "node scripts/pick.mjs dev",
    "dev:docs": "turbo watch build --filter=@devdogsuga/docs",
    "typecheck": "node scripts/pick.mjs typecheck",
    "lint": "node scripts/pick.mjs lint",
    "lint:fix": "node scripts/pick.mjs lint:fix",
    "test": "node scripts/pick.mjs test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx,json,css}\" --cache --ignore-path .gitignore --ignore-path .prettierignore",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx,json,css}\" --cache --ignore-path .gitignore --ignore-path .prettierignore",
    "sb": "pnpm --filter @devdogsuga/devtools run cli",
    "setup": "pnpm --filter @devdogsuga/devtools run cli:no-env setup",
    "airtable:scaffold": "pnpm --filter @devdogsuga/devtools run cli airtable scaffold",
    "airtable:pull-ids": "pnpm --filter @devdogsuga/devtools run cli airtable pull-ids",
    "airtable:verify": "pnpm --filter @devdogsuga/devtools run cli airtable verify",
    "airtable:snapshot": "pnpm --filter @devdogsuga/devtools run cli airtable snapshot",
    "airtable:snapshot:check": "pnpm --filter @devdogsuga/devtools run cli:no-env airtable snapshot --check",
    "env:example:check": "pnpm --filter @devdogsuga/devtools run cli:no-env env example --check",
    "devtools": "pnpm --filter @devdogsuga/devtools run cli",
    "bw": "pnpm --filter @devdogsuga/devtools exec bw"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@devdogsuga/env": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@11.8.0"
}
