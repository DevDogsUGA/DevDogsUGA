{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker naming is `${DEPLOY_ENV}-${APP_NAME}`; see apps/platform/wrangler.jsonc
  // for why the top level is the development shape and why `vars` is repeated
  // in full per environment rather than inherited.
  "name": "development-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },

  // --- development (top level) ---------------------------------------------
  // No route: `wrangler dev` serves locally, and every routing decision reads
  // `proxyHostname` from the database rather than inferring it from the
  // request host.
  "vars": {
    // The PLATFORM project's PostgREST endpoint, not a sandbox's. The secret
    // half is set with `wrangler secret put`.
    "PLATFORM_REST_URL": "https://REPLACE_ME.supabase.co/rest/v1",
  },

  // SANDBOX_PROXY_TOKEN is a secret, never a var. It is a JWT carrying
  // {"role": "sandbox_proxy"}, minted at deploy time by signing with the
  // platform project's own signing key -- no API call, no dashboard step, so
  // rotation is free and should happen on every deploy with a 90-day exp.
  "env": {
    "staging": {
      "name": "staging-sandbox",
      "vars": {
        "PLATFORM_REST_URL": "https://REPLACE_ME.supabase.co/rest/v1",
      },
      // A distinct wildcard, because two workers cannot both claim
      // `*-sandbox.devdogsuga.org/*`. Still one label deep, which is the
      // constraint that shaped the production pattern: Universal SSL covers the
      // apex and first-level subdomains only, and anything deeper needs
      // Advanced Certificate Manager at around $10/month.
      //
      // Changing this shape later means rewriting every stored
      // `proxyHostname` in the staging database.
      "routes": [
        {
          "pattern": "*-sandbox-staging.devdogsuga.org/*",
          "zone_name": "devdogsuga.org",
        },
      ],
    },

    "production": {
      "name": "production-sandbox",
      "vars": {
        "PLATFORM_REST_URL": "https://REPLACE_ME.supabase.co/rest/v1",
      },
      // One route and one wildcard DNS record cover every sandbox environment
      // forever, so creating one writes a database row and does no DNS work at
      // all.
      //
      // One label deep is deliberate: Universal SSL covers the apex and
      // first-level subdomains only, and `<env>.sandbox.devdogsuga.org` would
      // need Advanced Certificate Manager at around $10/month. Changing this
      // shape later means rewriting every stored `proxyHostname`.
      "routes": [
        {
          "pattern": "*-sandbox.devdogsuga.org/*",
          "zone_name": "devdogsuga.org",
        },
      ],
    },
  },
}
