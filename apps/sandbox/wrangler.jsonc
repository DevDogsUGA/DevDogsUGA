{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker naming is `${DEPLOY_ENV}-${APP_NAME}`; see apps/platform/wrangler.jsonc
  // for why the top level is the development shape. Note that wrangler does NOT
  // inherit `vars` into an environment block -- which is why the top-level entry
  // below reaches `wrangler dev` and nothing else.
  "name": "development-sandbox",
  // See apps/platform/wrangler.jsonc: pinned for the scoped deploy token.
  "account_id": "61d185ff419ef7bd5bd4b3d314081a49",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },

  // --- development (top level) ---------------------------------------------
  // No route: `wrangler dev` serves locally, and every routing decision reads
  // `proxyHostname` from the database rather than inferring it from the
  // request host.
  //
  // The local Supabase stack's PostgREST endpoint, which is what `wrangler dev`
  // should talk to and the one environment whose value IS the same on every
  // machine. Deployed environments carry no `vars` block at all -- see below.
  "vars": {
    "PLATFORM_REST_URL": "http://127.0.0.1:54321/rest/v1",
  },

  // NEITHER binding is committed for a deployed environment, and both absences
  // are deliberate.
  //
  // SANDBOX_PROXY_TOKEN is a secret, never a var. It is a JWT carrying
  // {"role": "sandbox_proxy"}, minted at deploy time by
  // `devtools deploy mint-token` signing with the platform project's own
  // signing key -- no API call, no dashboard step, so rotation is free and
  // should happen on every deploy with a 90-day exp.
  //
  // PLATFORM_REST_URL used to be committed here as
  // `https://REPLACE_ME.supabase.co/rest/v1`, identically in all three
  // environments. That is not a value awaiting a fill-in: one committed string
  // cannot be right for three projects, so the placeholder was the honest
  // shape of the idea and it was never going to be edited. It is a registry
  // entry now (`apps/sandbox/env.ts`), supplied at deploy time as
  // `--var PLATFORM_REST_URL:$REST_URL` from the environment's own env file.
  //
  // ⚠️ Deploying without supplying it leaves the binding UNDEFINED, which
  // `src/index.ts` answers with a named 503 `proxy_misconfigured`. That is the
  // improvement: `REPLACE_ME` produced a DNS failure on every request instead,
  // which reads as an upstream outage rather than as a missing setting.
  "env": {
    "staging": {
      "name": "staging-sandbox",
      // A distinct wildcard, because two workers cannot both claim
      // `*-sandbox.devdogsuga.org/*`. Still one label deep, which is the
      // constraint that shaped the production pattern: Universal SSL covers the
      // apex and first-level subdomains only, and anything deeper needs
      // Advanced Certificate Manager at around $10/month.
      //
      // ⚠️ This pattern and `SANDBOX_SUFFIXES.staging` in
      // apps/platform/src/server/sandbox/hostname.ts are two halves of one
      // fact. Until 2026-08-29 they disagreed: the platform's suffix was a
      // single environment-blind constant, so no hostname it generated could
      // match this route. Staging sandboxes fell under PRODUCTION's wildcard
      // instead, where the production Worker resolved the token against the
      // production database and answered `410` — a routing fault that named the
      // member's token. Change one, change the other.
      //
      // Changing this shape later means rewriting every stored
      // `proxyHostname` in the staging database.
      "routes": [
        {
          "pattern": "*-sandbox-staging.devdogsuga.org/*",
          "zone_name": "devdogsuga.org",
        },
      ],
    },

    "production": {
      "name": "production-sandbox",
      // One route and one wildcard DNS record cover every sandbox environment
      // forever, so creating one writes a database row and does no DNS work at
      // all.
      //
      // One label deep is deliberate: Universal SSL covers the apex and
      // first-level subdomains only, and `<env>.sandbox.devdogsuga.org` would
      // need Advanced Certificate Manager at around $10/month. Changing this
      // shape later means rewriting every stored `proxyHostname`.
      "routes": [
        {
          "pattern": "*-sandbox.devdogsuga.org/*",
          "zone_name": "devdogsuga.org",
        },
      ],
    },
  },
}
