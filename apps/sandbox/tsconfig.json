{
  // NOT extending config/tsconfig/lib.json, unlike the other packages here.
  // That preset is for emitting Node libraries: nodenext resolution (which
  // demands ".js" extensions on relative imports) and Node's globals. A Worker
  // is neither -- wrangler bundles it, so resolution is bundler-style, and its
  // runtime globals come from workerd rather than Node.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025"],
    "noEmit": true,
    // The workerd runtime's globals: Request, Response, ExecutionContext,
    // crypto.subtle. Deliberately NOT alongside "node" -- mixing the two lets
    // Node-only APIs typecheck and then fail at the edge.
    "types": ["@cloudflare/workers-types"]
  },
  // `env.ts` at the package root is the env manifest: nothing imports it, so
  // without an explicit entry here it would never be typechecked and its
  // define() metadata would be unenforced. Same arrangement as
  // packages/devtools/tsconfig.json. It is NOT under `src` on purpose -- it is
  // repository tooling read by devtools under Node, not Worker source, and
  // wrangler bundles from `src/index.ts` so it can never reach the edge.
  "include": ["src", "env.ts"]
}
