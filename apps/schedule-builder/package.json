{
  "name": "@devdogsuga/schedule-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "dotenvx run --quiet -f ../../.env -- next dev",
    "dev:local": "dotenvx run --quiet -f ../../.env.generated -f ../../.env -- next dev",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache",
    "db:generate": "dotenvx run --quiet -f ../../.env -- drizzle-kit generate --config drizzle-migrations.config.ts",
    "db:pull": "dotenvx run --quiet -f ../../.env -- drizzle-kit pull --config drizzle-introspection.config.ts",
    "db:pull:local": "dotenvx run --quiet -f ../../.env.generated -f ../../.env -- drizzle-kit pull --config drizzle-introspection.config.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "dotenvx run --quiet -f ../../.env.generated -f ../../.env -- opennextjs-cloudflare preview",
    "cf:deploy": "dotenvx run --quiet -f ../../.env -- opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@devdogsuga/feedback-client": "workspace:*",
    "@devdogsuga/oauth-setup": "workspace:*",
    "@devdogsuga/sb": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-toast": "^1.2.16",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.3",
    "match-sorter": "^8.3.0",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "sharp": "^0.35.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@devdogsuga/docs-preview": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^25.9.3",
    "wrangler": "^4.42.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "1.0.0-rc.3",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1"
  }
}
