{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker naming is `${DEPLOY_ENV}-${APP_NAME}`; see apps/platform/wrangler.jsonc
  // for why the top level is the development shape and why `vars`, `services`,
  // `images`, `r2_buckets` and `send_email` are repeated in full per
  // environment rather than inherited.
  "name": "development-schedule-builder",
  // Custom entry composes the OpenNext `fetch` handler with the cron
  // `scheduled` handler (see cloudflare/worker.ts + cloudflare/scheduled.ts).
  "main": "cloudflare/worker.ts",
  // Matches the `workerd` version pinned in the lockfile (1.20260722.x), which
  // is how the OpenNext adapter derives its own default. Keeping it at the
  // installed runtime's date rather than today's avoids `preview` warning that
  // the local workerd predates the configured date. Bump this alongside
  // wrangler; the adapter warns once it is more than six months stale.
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // --- development (top level) ---------------------------------------------
  "vars": {
    "DEPLOY_ENV": "development",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "development-schedule-builder-cache",
    },
  ],

  "env": {
    "staging": {
      "name": "staging-schedule-builder",
      "vars": {
        "DEPLOY_ENV": "staging",
      },
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "staging-schedule-builder-cache",
        },
      ],
      // Empty ON PURPOSE. The scrape hits UGA's registrar and RateMyProfessors
      // from a shared IP pool; running it twice a day from two workers doubles
      // the load those sites see for no extra coverage, and is the kind of
      // thing that gets a range blocked. Trigger it by hand against staging.
      "triggers": {
        "crons": [],
      },
      // Dog Days (the schedule builder's brand) lives on its own zone,
      // dogdays.dev -- one label deep, so Universal SSL covers it without
      // Advanced Certificate Manager. The ZONE must exist in the Cloudflare
      // account before the first deploy with this route; the custom domain
      // itself is provisioned by the deploy. Change it here and in the
      // staging SCHEDULE_BUILDER_URL value together; nothing cross-checks
      // them.
      "routes": [
        {
          "pattern": "staging.dogdays.dev",
          "custom_domain": true,
        },
      ],
    },

    "production": {
      "name": "production-schedule-builder",
      "vars": {
        "DEPLOY_ENV": "production",
      },
      // Backing store for the incremental cache. The binding name is fixed by
      // the OpenNext adapter. Without it the adapter falls back to its "dummy"
      // cache, which uploads nothing on deploy and throws on every read --
      // every prerendered route is then re-rendered per request. This applies
      // even though this app does not use Cache Components: its 14 fully static
      // routes go through the incremental cache too, not the ASSETS binding.
      // See packages/config/opennext/cloudflare.js.
      //
      // Created automatically on first deploy, per worker, so storage and
      // operation metrics stay attributable per environment.
      //
      // TODO: add an R2 object lifecycle rule (delete after ~30 days). Cache
      // keys include the build id, so every deploy writes a fresh copy and
      // nothing ever removes the previous one.
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "production-schedule-builder-cache",
        },
      ],
      // Daily registrar/RMP scrape (replaces the vercel.json cron). See
      // cloudflare/scheduled.ts. NOTE: the scrapers are long-running --
      // validate them against Workers CPU/wall-time limits and consider
      // Queues/Workflows or chunked runs before relying on a single scheduled
      // invocation.
      "triggers": {
        "crons": ["5 14 * * *"],
      },
      // Dog Days production. Unlike the platform's devdogsuga.org there is
      // no cutover -- this worker has never been deployed and nothing else
      // holds the hostname -- so the first deploy simply claims it, once the
      // dogdays.dev zone exists in the account. Keep in step with the
      // production SCHEDULE_BUILDER_URL value.
      "routes": [
        {
          "pattern": "dogdays.dev",
          "custom_domain": true,
        },
      ],
    },
  },
}
