{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker naming is `${DEPLOY_ENV}-${APP_NAME}`; see apps/platform/wrangler.jsonc
  // for why the top level is the development shape and why `vars`, `services`,
  // `images`, `kv_namespaces`, `hyperdrive` and `workflows` are repeated in
  // full per environment rather than inherited.
  "name": "development-schedule-builder",
  // See apps/platform/wrangler.jsonc: the scoped deploy token defeats
  // vinext/wrangler's account inference, so the account is pinned. Not a
  // secret.
  "account_id": "61d185ff419ef7bd5bd4b3d314081a49",
  // Custom entry composes vinext's app-router `fetch` handler with the cron
  // `scheduled` handler (see cloudflare/worker.ts + cloudflare/scheduled.ts).
  "main": "cloudflare/worker.ts",
  // Matches the `workerd` version pinned in the lockfile (1.20260916.x), which
  // is how @cloudflare/vite-plugin derives its own default. Keeping it at the
  // installed runtime's date rather than today's avoids `preview` warning that
  // the local workerd predates the configured date. Bump this alongside
  // wrangler; the plugin warns once it is more than six months stale.
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // vinext resolves this itself at build time (to `dist/client`, relative to
  // the emitted `dist/server/wrangler.json`) regardless of what is written
  // here -- this value only matters for a bare `wrangler dev`/`deploy` run
  // against this source file directly (no build in between), which is not a
  // supported path (see `main`: `cloudflare/worker.ts` is TypeScript, not a
  // built bundle). Kept as the honest pre-build shape rather than a path that
  // does not exist yet on a clean checkout.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  // Not inherited per-env because it isn't an env-scoped field to begin
  // with -- unlike `vars`/`services`/etc., this key applies to the whole
  // Worker resource, so one top-level block (see apps/platform/wrangler.jsonc)
  // covers development, staging, and production alike. `invocation_logs`
  // is the second layer the workspace's Sentry design deliberately keeps on
  // alongside Sentry: Cloudflare's own per-invocation log lines survive even
  // if the Sentry ingest side is unreachable or unconfigured.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // `vinext init` appended these two keys at the top level. Unlike
  // `account_id`/`observability`, `cache` and `version_metadata` ARE
  // non-inheritable -- `wrangler` warns explicitly ("exists at the top
  // level, but not on env.<x> ... not inherited by environments") if they
  // are left only here, so both are repeated per env below as well.
  //
  // `cache.enabled` turns on vinext's CDN-cache-adapter integration with the
  // deployed Worker's Cache API (see vite.config.ts's `cdnAdapter()`).
  "cache": { "enabled": true },
  // Exposes the deployment's version id to the Worker so Sentry release
  // tagging and cache-key namespacing can read it without a build-time
  // `SENTRY_RELEASE` var. Not a secret.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // --- development (top level) ---------------------------------------------
  "vars": {
    "DEPLOY_ENV": "development",
  },
  // vinext's data-cache adapter (`kvDataAdapter()` in vite.config.ts) backs
  // Next's fetch/`use cache` incremental cache with this KV namespace instead
  // of OpenNext's R2 bucket -- see the staging/production blocks for why this
  // one is a clearly-marked placeholder rather than a real id. `wrangler dev`
  // (unlike `deploy`) runs local-only by default, so a placeholder id is
  // harmless here: nothing ever resolves it against the real API, it only
  // names a local SQLite-backed KV emulation on disk.
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "<no-remote-namespace-development-runs-local-only>",
    },
  ],
  // Next's default image optimiser needs `sharp`, a native Node binary that
  // cannot run in workerd, so `next/image` requests fail on the deployed
  // worker without this binding. Non-inheritable, hence repeated per
  // environment.
  "images": {
    "binding": "IMAGES",
  },
  // Backs the daily registrar scrape (see cloudflare/ScrapeWorkflow.ts).
  // Bound in every environment, including development, so the class registers
  // with wrangler/`wrangler dev` regardless of whether this tier has a native
  // Workflow schedule.
  "workflows": [
    {
      "binding": "SCRAPE_WORKFLOW",
      "name": "development-schedule-builder-scrape",
      "class_name": "ScrapeWorkflow",
    },
  ],

  "env": {
    "staging": {
      "name": "staging-schedule-builder",
      "vars": {
        "DEPLOY_ENV": "staging",
      },
      // Real namespace, created via
      // `with-env --tier staging wrangler kv namespace create
      // staging-schedule-builder-vinext-cache` (named to match the
      // R2-bucket-era convention -- `{tier}-schedule-builder-cache` --  with
      // `-vinext` inserted so the retired R2 bucket and this replacement are
      // never confused while both still show up in `wrangler r2 bucket list`
      // / `wrangler kv namespace list` during the Phase 4 cleanup window).
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "7fac960f284f4df1ac1ec2f450899449",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      // See the top-level block: not inherited, repeated per env.
      "cache": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // Hyperdrive pools connections to Supabase's direct database endpoint so
      // request-scoped clients don't exhaust Postgres. The id is public; the
      // origin credential stays encrypted in Cloudflare. SHARED with the
      // platform Worker -- both point at the same Supabase project per tier, so
      // this reuses platform's staging Hyperdrive config rather than
      // provisioning a second one against the same origin. Bound in staging and
      // production only; development uses DB_URL (see src/server/db/index.ts).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7ca9f62ed356489f956cc854a17d7eed",
        },
      ],
      // See the top-level block for what this binds.
      "workflows": [
        {
          "binding": "SCRAPE_WORKFLOW",
          "name": "staging-schedule-builder-scrape",
          "class_name": "ScrapeWorkflow",
        },
      ],
      // Empty ON PURPOSE. The scrape hits UGA's registrar
      // from a shared IP pool; running it twice a day from two workers doubles
      // the load that site sees for no extra coverage, and is the kind of
      // thing that gets a range blocked. Trigger it by hand against staging.
      "triggers": {
        "crons": [],
      },
      // Dog Days (the schedule builder's brand) lives on its own zone,
      // dogdays.dev -- one label deep, so Universal SSL covers it without
      // Advanced Certificate Manager. The ZONE must exist in the Cloudflare
      // account before the first deploy with this route; the custom domain
      // itself is provisioned by the deploy. Change it here and in the
      // staging SCHEDULE_BUILDER_URL value together; nothing cross-checks
      // them.
      "routes": [
        {
          "pattern": "staging.dogdays.dev",
          "custom_domain": true,
        },
      ],
    },

    "production": {
      "name": "production-schedule-builder",
      "vars": {
        "DEPLOY_ENV": "production",
      },
      // Real namespace, created via
      // `with-env --tier production wrangler kv namespace create
      // production-schedule-builder-vinext-cache`. Backing store for the data
      // cache. The binding name is fixed by vinext's `kvDataAdapter()` config
      // in vite.config.ts. Without it every `fetch`/`use cache` read misses
      // and re-executes per request -- there is no "dummy adapter" fallback
      // the way OpenNext's R2 adapter had, the binding is simply undefined
      // and the adapter throws.
      //
      // Created out-of-band (`wrangler kv namespace create`), per worker, so
      // storage and read/write metrics stay attributable per environment.
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "c6b32e5e573e4209a5270481f1c5d0da",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      // See the top-level block: not inherited, repeated per env.
      "cache": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // See the staging block for why this reuses platform's Hyperdrive config.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "2bb3ae474d974fe99e4f36b3c5aaf896",
        },
      ],
      // See the top-level block for what this binds.
      "workflows": [
        {
          "binding": "SCRAPE_WORKFLOW",
          "name": "production-schedule-builder-scrape",
          "class_name": "ScrapeWorkflow",
          // Workflow schedules are UTC. Keeping this on the binding makes the
          // trigger visible on the Workflow itself and creates an instance
          // directly, without a Worker scheduled-handler intermediary.
          "schedules": ["5 14 * * *"],
        },
      ],
      // Explicitly empty so the next production deploy removes the legacy
      // Worker cron. Omitting this block leaves deployed Worker cron triggers
      // unchanged, which would double-start the scrape alongside the native
      // Workflow schedule above.
      "triggers": {
        "crons": [],
      },
      // Dog Days production. Unlike the platform's devdogsuga.org there is
      // no cutover -- this worker has never been deployed and nothing else
      // holds the hostname -- so the first deploy simply claims it, once the
      // dogdays.dev zone exists in the account. Keep in step with the
      // production SCHEDULE_BUILDER_URL value.
      "routes": [
        {
          "pattern": "dogdays.dev",
          "custom_domain": true,
        },
      ],
    },
  },
}
