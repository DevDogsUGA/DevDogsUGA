{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devdogs-schedule-builder",
  // Custom entry composes the OpenNext `fetch` handler with the cron
  // `scheduled` handler (see cloudflare/worker.ts + cloudflare/scheduled.ts).
  "main": "cloudflare/worker.ts",
  // Matches the `workerd` version pinned in the lockfile (1.20260722.x), which
  // is how the OpenNext adapter derives its own default. Keeping it at the
  // installed runtime's date rather than today's avoids `preview` warning that
  // the local workerd predates the configured date. Bump this alongside
  // wrangler; the adapter warns once it is more than six months stale.
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backing store for the incremental cache. The binding name is fixed by the
  // OpenNext adapter. Without it the adapter falls back to its "dummy" cache,
  // which uploads nothing on deploy and throws on every read — every
  // prerendered route is then re-rendered per request. This applies even though
  // this app does not use Cache Components: its 14 fully static routes go
  // through the incremental cache too, not the ASSETS binding. See
  // packages/config/opennext/cloudflare.js.
  //
  // Created automatically on first deploy. Each worker gets its own bucket so
  // storage and operation metrics stay attributable per app.
  //
  // TODO: add an R2 object lifecycle rule (delete after ~30 days). Cache keys
  // include the build id, so every deploy writes a fresh copy and nothing ever
  // removes the previous one.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "devdogs-schedule-builder-cache"
    }
  ],
  // Non-secret runtime vars. DEPLOY_ENV drives env.ts switchEnvironment()
  // (replaces the old Vercel VERCEL_ENV); override per-environment as needed.
  // Secrets (CRON_SECRET, BASE_URL, Supabase creds, …) come from
  // `wrangler secret put` / .dev.vars — see .dev.vars.example.
  "vars": {
    "DEPLOY_ENV": "production"
  },
  // Daily registrar/RMP scrape (replaces the vercel.json cron). See
  // cloudflare/scheduled.ts. NOTE: the scrapers are long-running — validate
  // them against Workers CPU/wall-time limits and consider Queues/Workflows or
  // chunked runs before relying on a single scheduled invocation.
  "triggers": {
    "crons": ["5 14 * * *"]
  }
}
