{
  "name": "study-group-finder",
  "version": "0.1.0",
  "private": true,
  "comment": "Turborepo task wrapper for the Flutter app. The real toolchain is Flutter/Dart; these scripts shell out to it via the root `with-env` helper so the Flutter build reads the shared root .env. They use `with-env -c` because $API_URL and friends must expand from the loaded .env rather than the ambient environment. Requires the Flutter SDK on PATH.",
  "dependencies": {
    "@devdogsuga/supabase": "workspace:*"
  },
  "scripts": {
    "build": "with-env -c 'flutter build web --dart-define=SUPABASE_URL=$API_URL --dart-define=SUPABASE_PUBLISHABLE_KEY=$PUBLISHABLE_KEY --dart-define=AUTH_MODE=${NEXT_PUBLIC_AUTH_MODE:-devdogs}'",
    "dev": "with-env -c 'flutter run --dart-define=SUPABASE_URL=$API_URL --dart-define=SUPABASE_PUBLISHABLE_KEY=$PUBLISHABLE_KEY --dart-define=AUTH_MODE=${NEXT_PUBLIC_AUTH_MODE:-devdogs}'",
    "dev:local": "with-env --local -c 'flutter run --dart-define=SUPABASE_URL=$API_URL --dart-define=SUPABASE_PUBLISHABLE_KEY=$PUBLISHABLE_KEY --dart-define=AUTH_MODE=${NEXT_PUBLIC_AUTH_MODE:-devdogs}'",
    "test": "flutter test",
    "lint": "flutter analyze",
    "generate-types": "with-env -c 'SUPABASE_URL=$API_URL SUPABASE_API_KEY=$SECRET_KEY dart run supadart'",
    "generate-types:local": "with-env --local -c 'SUPABASE_URL=$API_URL SUPABASE_API_KEY=$SECRET_KEY dart run supadart'"
  },
  "devDependencies": {
    "@devdogsuga/with-env": "workspace:*"
  }
}
