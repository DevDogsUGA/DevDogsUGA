{
  "name": "workshops",
  "displayName": "DevDogs Workshops",
  "publisher": "devdogsuga",
  "version": "0.1.0",
  "private": true,
  "description": "Follow DevDogs workshops in your own clone: review each step's changes against your code and accept or reject them.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/Backstage.git",
    "directory": "apps/workshops-vscode"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Education",
    "SCM Providers"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devdogsWorkshops",
          "title": "Workshop",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "devdogsWorkshops": [
        {
          "id": "devdogsWorkshops.steps",
          "name": "Steps"
        },
        {
          "id": "devdogsWorkshops.review",
          "name": "Review"
        },
        {
          "id": "devdogsWorkshops.live",
          "name": "● Live",
          "when": "devdogsWorkshops.live"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devdogsWorkshops.steps",
        "contents": "Open a DevDogs workshop repository to see its steps here.\n[Refresh](command:devdogsWorkshops.refresh)",
        "when": "!devdogsWorkshops.hasWorkshop"
      },
      {
        "view": "devdogsWorkshops.review",
        "contents": "No review in progress. Pick a step above to review its changes against your code.",
        "when": "!devdogsWorkshops.reviewActive"
      }
    ],
    "commands": [
      {
        "command": "devdogsWorkshops.reviewToStep",
        "title": "Review changes up to this step",
        "category": "Workshop",
        "icon": "$(git-compare)"
      },
      {
        "command": "devdogsWorkshops.goToStep",
        "title": "Go to step…",
        "category": "Workshop"
      },
      {
        "command": "devdogsWorkshops.refresh",
        "title": "Refresh steps",
        "category": "Workshop",
        "icon": "$(refresh)"
      },
      {
        "command": "devdogsWorkshops.moveMyWork",
        "title": "Move my work to my own branch",
        "category": "Workshop"
      },
      {
        "command": "devdogsWorkshops.jumpToStep",
        "title": "Jump to step (discard my changes)…",
        "category": "Workshop"
      },
      {
        "command": "devdogsWorkshops.review.acceptChange",
        "title": "Accept this change",
        "category": "Workshop",
        "icon": "$(check)"
      },
      {
        "command": "devdogsWorkshops.review.rejectChange",
        "title": "Reject this change",
        "category": "Workshop",
        "icon": "$(close)"
      },
      {
        "command": "devdogsWorkshops.review.acceptAtCursor",
        "title": "Accept change at cursor",
        "category": "Workshop",
        "icon": "$(check)"
      },
      {
        "command": "devdogsWorkshops.review.rejectAtCursor",
        "title": "Reject change at cursor",
        "category": "Workshop",
        "icon": "$(close)"
      },
      {
        "command": "devdogsWorkshops.review.acceptFile",
        "title": "Accept file",
        "category": "Workshop",
        "icon": "$(check-all)"
      },
      {
        "command": "devdogsWorkshops.review.rejectFile",
        "title": "Reject file",
        "category": "Workshop",
        "icon": "$(close-all)"
      },
      {
        "command": "devdogsWorkshops.review.nextFile",
        "title": "Next file",
        "category": "Workshop",
        "icon": "$(arrow-right)"
      },
      {
        "command": "devdogsWorkshops.review.acceptAll",
        "title": "Accept all changes",
        "category": "Workshop",
        "icon": "$(check-all)"
      },
      {
        "command": "devdogsWorkshops.review.rejectAll",
        "title": "Reject all changes",
        "category": "Workshop",
        "icon": "$(close-all)"
      },
      {
        "command": "devdogsWorkshops.review.finish",
        "title": "Finish review",
        "category": "Workshop",
        "icon": "$(git-merge)"
      },
      {
        "command": "devdogsWorkshops.review.cancel",
        "title": "Cancel review",
        "category": "Workshop",
        "icon": "$(close)"
      },
      {
        "command": "devdogsWorkshops.review.openFile",
        "title": "Open file in review",
        "category": "Workshop"
      },
      {
        "command": "devdogsWorkshops.review.runCommand",
        "title": "Run in terminal",
        "category": "Workshop",
        "icon": "$(play)"
      },
      {
        "command": "devdogsWorkshops.review.runAllCommands",
        "title": "Run all commands",
        "category": "Workshop",
        "icon": "$(run-all)"
      },
      {
        "command": "devdogsWorkshops.review.confirmCommand",
        "title": "I ran it",
        "category": "Workshop",
        "icon": "$(check)"
      },
      {
        "command": "devdogsWorkshops.review.skipCommands",
        "title": "Skip the commands",
        "category": "Workshop"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devdogsWorkshops.reviewToStep",
          "when": "false"
        },
        {
          "command": "devdogsWorkshops.review.acceptChange",
          "when": "false"
        },
        {
          "command": "devdogsWorkshops.review.rejectChange",
          "when": "false"
        },
        {
          "command": "devdogsWorkshops.review.openFile",
          "when": "false"
        },
        {
          "command": "devdogsWorkshops.review.runCommand",
          "when": "false"
        },
        {
          "command": "devdogsWorkshops.review.confirmCommand",
          "when": "false"
        },
        {
          "command": "devdogsWorkshops.review.acceptAtCursor",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.rejectAtCursor",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.acceptFile",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.rejectFile",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.nextFile",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.acceptAll",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.rejectAll",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.finish",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.cancel",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.runAllCommands",
          "when": "devdogsWorkshops.reviewActive"
        },
        {
          "command": "devdogsWorkshops.review.skipCommands",
          "when": "devdogsWorkshops.reviewActive"
        }
      ],
      "view/title": [
        {
          "command": "devdogsWorkshops.refresh",
          "when": "view == devdogsWorkshops.steps",
          "group": "navigation"
        },
        {
          "command": "devdogsWorkshops.review.cancel",
          "group": "navigation",
          "when": "view == devdogsWorkshops.review && devdogsWorkshops.reviewActive"
        }
      ],
      "view/item/context": [
        {
          "command": "devdogsWorkshops.reviewToStep",
          "when": "view == devdogsWorkshops.steps && viewItem == step",
          "group": "inline"
        },
        {
          "command": "devdogsWorkshops.reviewToStep",
          "when": "view == devdogsWorkshops.steps && viewItem == step",
          "group": "1_review"
        },
        {
          "command": "devdogsWorkshops.jumpToStep",
          "when": "view == devdogsWorkshops.steps && viewItem == step",
          "group": "9_danger"
        },
        {
          "command": "devdogsWorkshops.moveMyWork",
          "when": "view == devdogsWorkshops.steps && viewItem == warning",
          "group": "inline"
        },
        {
          "command": "devdogsWorkshops.review.runCommand",
          "group": "inline",
          "when": "view == devdogsWorkshops.review && viewItem =~ /^command-(pending|failed|sent)$/"
        },
        {
          "command": "devdogsWorkshops.review.confirmCommand",
          "group": "inline",
          "when": "view == devdogsWorkshops.review && viewItem == command-sent"
        },
        {
          "command": "devdogsWorkshops.review.acceptFile",
          "group": "inline@1",
          "when": "view == devdogsWorkshops.review && viewItem == reviewFile"
        },
        {
          "command": "devdogsWorkshops.review.rejectFile",
          "group": "inline@2",
          "when": "view == devdogsWorkshops.review && viewItem == reviewFile"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "devdogsWorkshops.review.acceptChange",
          "group": "inline@1",
          "when": "commentController == devdogsWorkshops.review && commentThread != accept"
        },
        {
          "command": "devdogsWorkshops.review.rejectChange",
          "group": "inline@2",
          "when": "commentController == devdogsWorkshops.review && commentThread != reject"
        }
      ],
      "editor/title": [
        {
          "command": "devdogsWorkshops.review.acceptFile",
          "group": "navigation@1",
          "when": "devdogsWorkshops.inReviewFile"
        },
        {
          "command": "devdogsWorkshops.review.rejectFile",
          "group": "navigation@2",
          "when": "devdogsWorkshops.inReviewFile"
        },
        {
          "command": "devdogsWorkshops.review.nextFile",
          "group": "navigation@3",
          "when": "devdogsWorkshops.inReviewFile"
        }
      ],
      "editor/context": [
        {
          "command": "devdogsWorkshops.review.acceptAtCursor",
          "group": "9_workshop@1",
          "when": "resourceScheme == devdogs-review"
        },
        {
          "command": "devdogsWorkshops.review.rejectAtCursor",
          "group": "9_workshop@2",
          "when": "resourceScheme == devdogs-review"
        }
      ]
    },
    "configuration": {
      "title": "DevDogs Workshops",
      "properties": {
        "devdogsWorkshops.autoCommit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Commit the result of a finished review as a merge commit. When off, the result is staged and left as a merge in progress, so your own commit records the merge."
        },
        "devdogsWorkshops.followLive": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Follow live workshops: while a workshop repo is open, listen for the presenter finishing a step (you're offered a review) and tell the presenter which step number you're at. Nothing else is sent: no name, no code."
        },
        "devdogsWorkshops.liveRelayUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Websocket URL of the live relay, for testing. Empty uses the club's relay. Must start with `ws://` or `wss://`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node esbuild.mjs --minify && vsce package --no-dependencies",
    "test:vscode": "node esbuild.mjs && node esbuild.mjs --tests && node dist-test/run.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@sentry/node": "catalog:",
    "node-diff3": "^3.1.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "1.93.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
