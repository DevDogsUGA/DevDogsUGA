{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "pnpm --filter @devdogsuga/email run codegen && pnpm --filter @devdogsuga/docs run codegen && SKIP_ENV_VALIDATION=1 vinext typegen && tsx scripts/brand-images.ts",
    "prebuild": "pnpm run codegen",
    "build": "with-env vinext build",
    "predev": "pnpm run codegen",
    "dev": "with-env vinext dev",
    "start": "with-env --worker platform wrangler dev --config dist/server/wrangler.json --env-file {env-file}",
    "preview": "pnpm run build && pnpm run start",
    "prelint": "pnpm run codegen",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "pretypecheck": "pnpm run codegen",
    "typecheck": "tsc --noEmit && tsc -p cloudflare/tsconfig.json --noEmit",
    "pretest": "pnpm run codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:db": "pnpm run codegen",
    "test:db": "with-env vitest run --config vitest.db.config.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "types:cf": "wrangler types cloudflare-env.d.ts --env production --env-interface CloudflareEnv",
    "types:cf:check": "wrangler types cloudflare-env.d.ts --env production --env-interface CloudflareEnv --check",
    "types:drizzle": "with-env tsx ../../scripts/drizzle-pull.ts",
    "fetch:campus-map": "tsx scripts/fetch-campus-map.ts && prettier --write src/components/EventsSection/FindUs/campusMapData.ts src/components/EventsSection/FindUs/campusMapMeta.ts"
  },
  "dependencies": {
