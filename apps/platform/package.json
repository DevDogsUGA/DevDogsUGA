{
  "name": "@devdogsuga/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "dotenvx run --quiet -f ../../.env -- next dev",
    "dev:local": "dotenvx run --quiet -f ../../.env.generated -f ../../.env -- next dev",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "db:pull": "dotenvx run --quiet -f ../../.env -- drizzle-kit pull --config drizzle-introspection.config.ts && dotenvx run --quiet -f ../../.env -- drizzle-kit pull --config drizzle.config.ts && tsx scripts/post-pull.ts",
    "db:pull:local": "dotenvx run --quiet -f ../../.env.generated -f ../../.env -- drizzle-kit pull --config drizzle-introspection.config.ts && dotenvx run --quiet -f ../../.env.generated -f ../../.env -- drizzle-kit pull --config drizzle.config.ts && tsx scripts/post-pull.ts",
    "db:seed-roles": "dotenvx run --quiet -f ../../.env -- tsx scripts/seed-builtin-roles.ts",
    "db:seed-roles:local": "dotenvx run --quiet -f ../../.env.generated -f ../../.env -- tsx scripts/seed-builtin-roles.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "dotenvx run --quiet -f ../../.env.generated -f ../../.env -- opennextjs-cloudflare preview",
    "cf:deploy": "dotenvx run --quiet -f ../../.env -- opennextjs-cloudflare deploy",
    "docs:preview": "docs-preview"
  },
  "dependencies": {
