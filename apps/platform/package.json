{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "with-env next dev",
    "dev:local": "pnpm docs:index:local && with-env --local next dev",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "with-env --local vitest run --config vitest.db.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "db:pull": "with-env drizzle-kit pull --config drizzle-introspection.config.ts && with-env drizzle-kit pull --config drizzle.config.ts && tsx scripts/post-pull.ts",
    "db:pull:local": "with-env --local drizzle-kit pull --config drizzle-introspection.config.ts && with-env --local drizzle-kit pull --config drizzle.config.ts && tsx scripts/post-pull.ts",
    "db:seed-roles": "with-env tsx scripts/seed-builtin-roles.ts",
    "db:seed-roles:local": "with-env --local tsx scripts/seed-builtin-roles.ts",
    "docs:index": "pnpm --filter @devdogsuga/docs build && with-env tsx scripts/index-docs.ts",
    "docs:index:local": "pnpm --filter @devdogsuga/docs build && with-env --local tsx scripts/index-docs.ts",
    "cf:build": "with-env -c 'DEPLOY_ENV=production opennextjs-cloudflare build'",
    "cf:preview": "with-env --local opennextjs-cloudflare preview",
    "cf:deploy": "pnpm docs:index --force && with-env -c 'DEPLOY_ENV=production opennextjs-cloudflare deploy'"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
