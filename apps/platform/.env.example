# Platform-app-specific environment (optional override layer).
#
# Copy to "apps/platform/.env.local" (gitignored). These are values only the
# platform app needs at runtime and that config.toml does NOT read — so they
# live here rather than in the root ".env". The `with-env` wrapper loads this
# file FIRST (it wins over root ".env").

# Cron route auth (Bearer token checked by /api/cron/* and cron triggers)
CRON_SECRET=""

# Epoch used for DevDogs id/time math
DEVDOGS_EPOCH=""

# Your dev machine's VPN IP, for testing on a phone over VPN (HMR origin).
DEV_VPN_HOST=""

# GitHub app integration (leaderboard sync, docs sync, webhooks)
GITHUB_ORG="DevDogs-UGA"
GITHUB_TOKEN="ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GITHUB_WEBHOOK_SECRET=""

# Discord bot / interactions (role sync, slash commands)
DISCORD_GUILD_ID="1231994798165069987"
DISCORD_PUBLIC_KEY=""
DISCORD_TOKEN=""
