{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ==========================================================================
  // Worker naming: `${DEPLOY_ENV}-${APP_NAME}`.
  //
  // A slash would read better but is not legal -- wrangler rejects anything
  // outside "alphanumeric and lowercase with dashes only", so `-` is the
  // separator. The `devdogs-` prefix this used to carry is gone: the account
  // holds nothing but DevDogs workers, so it distinguished nothing, and it
  // pushed the meaningful part of the name past the point where the dashboard
  // truncates it.
  //
  // The TOP LEVEL IS THE DEVELOPMENT SHAPE, deliberately, and every deployable
  // value lives under `env.*` instead. Two reasons, both learned the hard way:
  //
  //   1. `routes` and `triggers` ARE inherited by environments. A staging
  //      deploy with the apex at top level reassigns devdogsuga.org away from
  //      production -- wrangler says so in a warning and then does it anyway.
  //      Nothing here is inherited, so nothing can be stolen.
  //   2. `wrangler deploy` with no `--env` uses this block.
  //      `development-platform` cannot collide with `production-platform`,
  //      the Worker serving the apex.
  //
  // NON-INHERITABLE keys must be repeated in full in every environment:
  // `vars`, `ratelimits`, `images`, `send_email`, `hyperdrive`, `kv_namespaces`,
  // `cache`, `version_metadata`. Omitting one does not fall back to the top
  // level -- the binding is simply absent, and the failure shows up at
  // runtime. Verified against wrangler 4.136:
  //   pnpm exec wrangler deploy --dry-run --env production
  // prints the resolved binding list and warns about every key left behind.
  // ==========================================================================
  "name": "development-platform",
  // Pinned because the deploy token is scoped and vinext/wrangler cannot
  // infer the account from it ("Could not determine Cloudflare account ID",
  // first staging deploy, back when this was OpenNext). Not a secret — it is
  // in every dashboard URL. Inherited by every environment block.
  "account_id": "61d185ff419ef7bd5bd4b3d314081a49",
  // Custom entry composes vinext's app-router `fetch` handler with the cron
  // `scheduled` handler (see cloudflare/worker.ts + cloudflare/scheduled.ts).
  "main": "cloudflare/worker.ts",
  // Matches the `workerd` version pinned in the lockfile (1.20260916.x), which
  // is how @cloudflare/vite-plugin derives its own default. Keeping it at the
  // installed runtime's date rather than today's avoids `preview` warning that
  // the local workerd predates the configured date. Bump this alongside
  // wrangler; the plugin warns once it is more than six months stale.
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // vinext resolves this itself at build time (to `dist/client`, relative to
  // the emitted `dist/server/wrangler.json`) regardless of what is written
  // here -- this value only matters for a bare `wrangler dev`/`deploy` run
  // against this source file directly (no build in between), which is not a
  // supported path (see `main`: `cloudflare/worker.ts` is TypeScript, not a
  // built bundle). Kept as the honest pre-build shape rather than a path that
  // does not exist yet on a clean checkout. See
  // apps/schedule-builder/wrangler.jsonc for the identical reasoning.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  // Without this, `wrangler tail` and the dashboard show nothing. Invocation
  // logs cover the cron triggers, which have no other observable output.
  // Not env-scoped to begin with (unlike `vars`/`ratelimits`/etc.), so one
  // top-level block covers development, staging, and production alike.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // `vinext init` appended these two keys at the top level. Unlike
  // `account_id`/`observability`, `cache` and `version_metadata` ARE
  // non-inheritable -- `wrangler` warns explicitly ("exists at the top
  // level, but not on env.<x> ... not inherited by environments") if they
  // are left only here, so both are repeated per env below as well. See
  // apps/schedule-builder/wrangler.jsonc, which hit the same warning first.
  //
  // `cache.enabled` turns on vinext's CDN-cache-adapter integration with the
  // deployed Worker's own Cache API (see vite.config.ts's `cdnAdapter()`),
  // replacing `WORKER_SELF_REFERENCE`'s self-invoking revalidation queue.
  "cache": { "enabled": true },
  // Exposes the deployment's version id to the Worker so Sentry release
  // tagging and cache-key namespacing can read it without a build-time
  // `SENTRY_RELEASE` var. Not a secret.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // --- development (top level) ---------------------------------------------
  // No `routes` and no `triggers`: an accidental env-less deploy should be
  // inert, not a second worker competing for the apex or firing the crons a
  // second time.
  "vars": {
    "DEPLOY_ENV": "development",
  },
  "ratelimits": [
    {
      "name": "ATTENDANCE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  // vinext's data-cache adapter (`kvDataAdapter()` in vite.config.ts) backs
  // Next's fetch/`use cache` incremental cache with this KV namespace instead
  // of OpenNext's R2 bucket -- see the staging/production blocks for why this
  // one is a clearly-marked placeholder rather than a real id. `wrangler dev`
  // (unlike `deploy`) runs local-only by default, so a placeholder id is
  // harmless here: nothing ever resolves it against the real API, it only
  // names a local SQLite-backed KV emulation on disk.
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "<no-remote-namespace-development-runs-local-only>",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@mail.devdogsuga.org"],
    },
  ],
  "env": {
    // ========================================================================
    // staging
    // ========================================================================
    "staging": {
      "name": "staging-platform",
      "vars": {
        "DEPLOY_ENV": "staging",
      },
      "ratelimits": [
        {
          "name": "ATTENDANCE_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      // Real namespace, created via
      // `with-env --tier staging wrangler kv namespace create
      // staging-platform-vinext-cache` (named to match schedule-builder's
      // convention -- `{tier}-{app}-cache` --  with `-vinext` inserted so the
      // retired R2 bucket and this replacement are never confused while both
      // still show up in `wrangler r2 bucket list` / `wrangler kv namespace
      // list` during the Phase 4 cleanup window).
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "09d8c2c0fe5343ebbfa87a8cea0ba348",
        },
      ],
      // See the top-level block: not inherited, repeated per env.
      "cache": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // Hyperdrive pools connections to Supabase's DIRECT database endpoint.
      // SQL result caching is disabled on the configuration: these queries are
      // permission-sensitive and often follow writes. The ID is public and the
      // origin credential stays encrypted in Cloudflare.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7ca9f62ed356489f956cc854a17d7eed",
        },
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@mail.devdogsuga.org"],
        },
      ],
      // The staging deployment lives at staging.devdogsuga.org. One label
      // deep, so Universal SSL covers it without Advanced Certificate Manager
      // -- the same constraint the sandbox worker's wildcard route is shaped
      // around.
      // Change it here and in the staging BASE_URL secret together; they are
      // read by different things and nothing cross-checks them.
      "routes": [
        {
          "pattern": "staging.devdogsuga.org",
          "custom_domain": true,
        },
      ],
      // Empty ON PURPOSE, and not merely omitted. Staging shares the club's
      // real Discord guild, so a staging cron is not a rehearsal --
      // `/cron/sync-discord-roles` would assign real roles to real members
      // twice. Cron behaviour is exercised by hitting the guarded routes by
      // hand with the staging CRON_SECRET.
      "triggers": {
        "crons": [],
      },
    },
    // ========================================================================
    // production
    // ========================================================================
    "production": {
      "name": "production-platform",
      "vars": {
        "DEPLOY_ENV": "production",
      },
      "ratelimits": [
        {
          "name": "ATTENDANCE_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      // Real namespace, created via
      // `with-env --tier production wrangler kv namespace create
      // production-platform-vinext-cache`. Backing store for the data cache.
      // The binding name is fixed by vinext's `kvDataAdapter()` config in
      // vite.config.ts. Without it every `fetch`/`use cache` read misses and
      // re-executes per request -- there is no "dummy adapter" fallback the
      // way OpenNext's R2 adapter had, the binding is simply undefined and
      // the adapter throws.
      //
      // Created out-of-band (`wrangler kv namespace create`), per worker, so
      // storage and read/write metrics stay attributable per environment.
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "f8564b9844c9420892c3acc2ecc1737c",
        },
      ],
      // See the top-level block: not inherited, repeated per env.
      "cache": { "enabled": true },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "2bb3ae474d974fe99e4f36b3c5aaf896",
        },
      ],
      // Transactional email. Supabase's sender is auth-only (signup
      // confirmation, magic link, password recovery) with no general-purpose
      // send API, so team invitations go through the Workers binding instead.
      //
      // `allowed_sender_addresses` is the part that matters: without it, any
      // code path with the binding in scope can send as any address on the
      // domain.
      //
      // Requires `wrangler email sending enable mail.devdogsuga.org` first,
      // which provisions the DKIM, SPF and DMARC records. Until that completes
      // every send returns E_SENDER_NOT_VERIFIED -- loudly, which is the good
      // case.
      //
      // For local development add `"remote": true` to the top-level copy so
      // sends proxy to the real service; without it there is nothing to
      // observe. Point it at an address you control -- bounces from invented
      // addresses land on the domain's reputation, and the suppression list is
      // not something to fill while testing.
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@mail.devdogsuga.org"],
        },
      ],
      // The production deployment serves the apex through this custom domain.
      "routes": [
        {
          "pattern": "devdogsuga.org",
          "custom_domain": true,
        },
      ],
      // Cron triggers replace the old vercel.json crons. cloudflare/scheduled.ts
      // routes each cron to its existing CRON_SECRET-guarded /api route.
      "triggers": {
        "crons": ["0 0 * * *", "*/15 * * * *"],
      },
    },
  },
}
