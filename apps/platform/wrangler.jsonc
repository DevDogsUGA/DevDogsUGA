{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ==========================================================================
  // Worker naming: `${DEPLOY_ENV}-${APP_NAME}`.
  //
  // A slash would read better but is not legal -- wrangler rejects anything
  // outside "alphanumeric and lowercase with dashes only", so `-` is the
  // separator. The `devdogs-` prefix this used to carry is gone: the account
  // holds nothing but DevDogs workers, so it distinguished nothing, and it
  // pushed the meaningful part of the name past the point where the dashboard
  // truncates it.
  //
  // The TOP LEVEL IS THE DEVELOPMENT SHAPE, deliberately, and every deployable
  // value lives under `env.*` instead. Two reasons, both learned the hard way:
  //
  //   1. `routes` and `triggers` ARE inherited by environments. A staging
  //      deploy with the apex at top level reassigns devdogsuga.org away from
  //      production -- wrangler says so in a warning and then does it anyway.
  //      Nothing here is inherited, so nothing can be stolen.
  //   2. `wrangler deploy` with no `--env` uses this block. Named `platform` it
  //      would have overwritten the pre-monorepo production worker, which is
  //      still serving the apex. `development-platform` cannot collide with
  //      anything real.
  //
  // NON-INHERITABLE keys must be repeated in full in every environment:
  // `vars`, `services`, `images`, `r2_buckets`, `hyperdrive`, `send_email`.
  // Omitting one does not fall back to the top level -- the binding is simply
  // absent, and the failure shows up at runtime. Verified against wrangler 4.118:
  //   pnpm exec wrangler deploy --dry-run --env production
  // prints the resolved binding list and warns about every key left behind.
  // ==========================================================================
  "name": "development-platform",
  // Pinned because the deploy token is scoped and OpenNext's R2 cache
  // provisioning cannot infer the account from it ("Could not determine
  // Cloudflare account ID", first staging deploy). Not a secret — it is in
  // every dashboard URL. Inherited by every environment block.
  "account_id": "61d185ff419ef7bd5bd4b3d314081a49",
  // Custom entry composes the OpenNext `fetch` handler with the cron
  // `scheduled` handler (see cloudflare/worker.ts + cloudflare/scheduled.ts).
  "main": "cloudflare/worker.ts",
  // Matches the `workerd` version pinned in the lockfile (1.20260722.x), which
  // is how the OpenNext adapter derives its own default. Keeping it at the
  // installed runtime's date rather than today's avoids `preview` warning that
  // the local workerd predates the configured date. Bump this alongside
  // wrangler; the adapter warns once it is more than six months stale.
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Inheritable, and identical everywhere, so it stays at the top level.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Without this, `wrangler tail` and the dashboard show nothing. Invocation
  // logs cover the cron triggers, which have no other observable output.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // --- development (top level) ---------------------------------------------
  // No `routes` and no `triggers`: an accidental env-less deploy should be
  // inert, not a second worker competing for the apex or firing the crons a
  // second time.
  "vars": {
    "DEPLOY_ENV": "development",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "development-platform",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "development-platform-cache",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@mail.devdogsuga.org"
      ],
    },
  ],
  "env": {
    // ========================================================================
    // staging
    // ========================================================================
    "staging": {
      "name": "staging-platform",
      "vars": {
        "DEPLOY_ENV": "staging",
      },
      // Must equal this environment's worker name -- a self-reference pointing
      // at production would have staging serve production's cached pages.
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "staging-platform",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "staging-platform-cache",
        },
      ],
      // Hyperdrive pools connections to Supabase's DIRECT database endpoint.
      // SQL result caching is disabled on the configuration: these queries are
      // permission-sensitive and often follow writes. The ID is public and the
      // origin credential stays encrypted in Cloudflare.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7ca9f62ed356489f956cc854a17d7eed",
          // Optional. Can be used to connect to a local database for local development with `wrangler dev`
          "localConnectionString": "${DB_URL}"
        },
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "noreply@mail.devdogsuga.org"
          ],
        },
      ],
      // ASSUMPTION, and the one value here nobody has confirmed: staging is
      // assumed to live at staging.devdogsuga.org. One label deep, so Universal
      // SSL covers it without Advanced Certificate Manager -- the same
      // constraint the sandbox worker's wildcard route is shaped around.
      // Change it here and in the staging BASE_URL secret together; they are
      // read by different things and nothing cross-checks them.
      "routes": [
        {
          "pattern": "staging.devdogsuga.org",
          "custom_domain": true,
        },
      ],
      // Empty ON PURPOSE, and not merely omitted. Staging shares the
      // production Airtable base (there is only one) and the club's real
      // Discord guild, so a staging cron is not a rehearsal -- `/airtable/sync`
      // would contend with production for the sync lease, and
      // `/cron/sync-discord-roles` would assign real roles to real members
      // twice. Cron behaviour is exercised by hitting the guarded routes by
      // hand with the staging CRON_SECRET.
      "triggers": {
        "crons": [],
      },
    },
    // ========================================================================
    // production
    // ========================================================================
    "production": {
      "name": "production-platform",
      "vars": {
        "DEPLOY_ENV": "production",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "production-platform",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      // Backing store for the incremental cache. The binding name is fixed by
      // the OpenNext adapter. Without it the adapter falls back to its "dummy"
      // cache, which uploads nothing on deploy and throws on every read --
      // every prerendered route is then re-rendered per request. See
      // packages/config/opennext/cloudflare.js.
      //
      // Created automatically on first deploy, per worker, so storage and
      // operation metrics stay attributable per environment.
      //
      // TODO: add an R2 object lifecycle rule (delete after ~30 days). Cache
      // keys include the build id, so every deploy writes a fresh copy and
      // nothing ever removes the previous one.
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "production-platform-cache",
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "2bb3ae474d974fe99e4f36b3c5aaf896",
        },
      ],
      // Transactional email. Supabase's sender is auth-only (signup
      // confirmation, magic link, password recovery) with no general-purpose
      // send API, so team invitations go through the Workers binding instead.
      //
      // `allowed_sender_addresses` is the part that matters: without it, any
      // code path with the binding in scope can send as any address on the
      // domain.
      //
      // Requires `wrangler email sending enable mail.devdogsuga.org` first,
      // which provisions the DKIM, SPF and DMARC records. Until that completes
      // every send returns E_SENDER_NOT_VERIFIED -- loudly, which is the good
      // case.
      //
      // For local development add `"remote": true` to the top-level copy so
      // sends proxy to the real service; without it there is nothing to
      // observe. Point it at an address you control -- bounces from invented
      // addresses land on the domain's reputation, and the suppression list is
      // not something to fill while testing.
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "noreply@mail.devdogsuga.org"
          ],
        },
      ],
      // The production apex. It is currently bound to the pre-monorepo worker,
      // which was named `platform`; the first deploy under this name has to
      // take the domain over. That is a deliberate cutover, not something a
      // deploy does quietly -- until it happens this worker is reachable only
      // on workers.dev.
      "routes": [
        {
          "pattern": "devdogsuga.org",
          "custom_domain": true,
        },
      ],
      // Cron triggers replace the old vercel.json crons. cloudflare/scheduled.ts
      // routes each cron to its existing CRON_SECRET-guarded /api route.
      "triggers": {
        "crons": [
          "0 0 * * *",
          "*/15 * * * *",
          "*/10 * * * *",
          "*/5 * * * *"
        ],
      },
    },
  },
}