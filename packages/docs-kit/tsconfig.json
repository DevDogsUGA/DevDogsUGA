{
  "extends": "@devdogsuga/config/tsconfig/lib.json",
  "compilerOptions": {
    "noEmit": true,
    // Test files import siblings without extensions; vitest resolves them.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
