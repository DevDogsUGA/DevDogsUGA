{
  // Emits: the platform imports `dist` through the package's default export
  // condition, while devtools resolves `devdogs-source` and runs the TypeScript
  // straight through tsx. Both have to typecheck, so `src` is the only input
  // and `scripts` is checked separately (tsconfig.typecheck.json) — it is a
  // repo-local generator that must never reach `dist`.
  "extends": "../config/tsconfig/lib.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    // The templates are JSX but nothing here ever mounts: Satori consumes the
    // plain {type, props} objects the automatic runtime produces. `react-jsx`
    // keeps React out of every template's import list.
    "jsx": "react-jsx",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // Tests are typechecked (tsconfig.typecheck.json includes them) but never
  // emitted: `dist` is what the platform bundles into a Cloudflare Worker, and
  // a `.test.js` in there is dead weight that still has to be parsed.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
