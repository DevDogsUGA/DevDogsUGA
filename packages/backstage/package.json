{
  "name": "@devdogsuga/backstage",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Officer and production CLI for DevDogsUGA: deploys, env sync with Bitwarden and GitHub, the migration planner role, club graphics and QR codes, GitHub rulesets and settings, and the newsletter. Ships built JS; run it anywhere with `pnpm dlx @devdogsuga/backstage` (no checkout needed to start; commands that read a checkout say so).",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/DevDogsUGA.git",
    "directory": "packages/backstage"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "backstage": "./bin/backstage.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "env.ts"
  ],
  "scripts": {
    "build": "tsdown && node scripts/write-build-info.mjs && node ../../scripts/check-bundle-imports.mjs",
    "cli": "node ./bin/backstage.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@bitwarden/cli": "2026.7.0",
    "@bitwarden/sdk-napi": "1.0.0",
    "@clack/prompts": "catalog:",
    "@devdogsuga/sdk": "workspace:*",
    "@dotenvx/dotenvx": "^2.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "cross-spawn": "^7.0.6",
    "dotenv": "^18.0.0",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "satori": "^0.33.4",
    "sharp": "0.35.5",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/cli-core": "workspace:*",
    "@devdogsuga/config": "workspace:*",
    "@devdogsuga/events": "workspace:*",
    "@devdogsuga/newsletter": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsdown": "^0.23.0",
    "vitest": "catalog:"
  }
}
