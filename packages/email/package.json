{
  "name": "@devdogsuga/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "react-email sources compiled to typed, React-free HTML templates",
  "exports": {
    ".": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "codegen": "tsx scripts/compile.tsx",
    "compile": "pnpm run codegen",
    "pretypecheck": "pnpm run codegen",
    "pretest": "pnpm run codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@devdogsuga/brand": "^0.1.4",
    "@devdogsuga/config": "^0.1.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
