{
  "name": "@devdogsuga/env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The environment-variable registry: one declaration per variable, carrying its schema and where it is allowed to live",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "devdogs-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "devdogs-source": "./src/load.ts",
      "default": "./dist/load.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.19.2",
    "@yarnpkg/fslib": "^3.1.5",
    "@yarnpkg/shell": "^4.1.3",
    "commander": "^14.0.3",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "with-env": "./bin/with-env.mjs"
  }
}
