{
  "name": "@devdogsuga/supabase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/database.types.d.ts",
      "default": "./dist/database.types.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "files": [
    "dist",
    "supabase"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p ../../supabase",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "with-env vitest run --config vitest.rls.config.ts",
    "test:coverage": "vitest run --coverage",
    "link-remote-project": "with-env -c 'supabase link --project-ref $PROJECT_REF'",
    "new-migration": "supabase migration new",
    "push-migrations": "with-env supabase db push && pnpm generate-types",
    "push-config": "with-env supabase config push",
    "reset-remote-database": "with-env supabase db reset --linked && pnpm generate-types && pnpm seed-buckets",
    "generate-types": "with-env supabase gen types --linked > src/database.types.ts && pnpm build",
    "seed-buckets": "with-env supabase seed buckets --linked",
    "start-local-stack": "with-env supabase start && with-env supabase status -o env > ../../.env.generated && pnpm seed-buckets:local",
    "stop-local-stack": "with-env supabase stop && node -e \"require('node:fs').rmSync('../../.env.generated',{force:true})\"",
    "reset-local-database": "with-env supabase db reset && with-env supabase gen types --local > src/database.types.ts && pnpm build && pnpm seed-buckets:local",
    "seed-buckets:local": "with-env supabase seed buckets --local --yes",
    "generate-types:local": "with-env supabase gen types --local > src/database.types.ts && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@devdogsuga/env": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "postgres": "catalog:",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
