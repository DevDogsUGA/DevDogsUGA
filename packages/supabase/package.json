{
  "name": "@devdogsuga/supabase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/database.types.ts",
      "default": "./src/database.types.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    }
  },
  "files": [
    "src",
    "supabase"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p ../../supabase",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "with-env vitest run --config vitest.rls.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@devdogsuga/config": "^0.1.1",
    "@devdogsuga/db": "^0.1.1",
    "@devdogsuga/env": "^0.1.2",
    "@supabase/supabase-js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "postgres": "catalog:",
    "supabase": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
