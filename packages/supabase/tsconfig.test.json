{
  // The RLS persona suite lives outside `src` so it is not part of
  // the library build nor published, but it should still be typechecked. tsconfig.json
  // covers the library; this covers the tests.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["testing/**/*.ts"]
}
