{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2025"],
    "types": ["node"],
    "noEmit": true
  },
  // `env.ts` at the package root is the operator/tooling environment
  // manifest — nothing imports it, so without an explicit entry here it
  // would never be typechecked and its define() metadata would be
  // unenforced.
  "include": ["src/**/*.ts", "env.ts"]
}
