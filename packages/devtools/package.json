{
  "name": "@devdogsuga/devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "devtools": "./src/cli.ts"
  },
  "scripts": {
    "cli": "with-env tsx --conditions=development src/cli.ts",
    "cli:no-env": "tsx --conditions=development src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@devdogsuga/airtable": "workspace:*",
    "@devdogsuga/env": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "dotenv": "^17.4.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@devdogsuga/with-env": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Contributor CLI: database, moderation checks, and OAuth setup"
}
