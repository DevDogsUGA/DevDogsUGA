    "@devdogsuga/docs": "workspace:*",
    "@devdogsuga/env": "workspace:*",
    "@devdogsuga/og": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "catalog:",
    "dotenv": "^17.4.2",
    "postgres": "catalog:",
    "prettier": "3.9.6",
    "qrcode": "1.5.4",
    "satori": "^0.33.4",
    "sharp": "0.35.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@devdogsuga/env": "workspace:*",
