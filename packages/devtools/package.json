{
  "name": "@devdogsuga/devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "devtools": "./src/cli.ts"
  },
  "scripts": {
    "cli": "with-env tsx --conditions=devdogs-source src/cli.ts",
    "cli:no-env": "tsx --conditions=devdogs-source src/cli.ts",
