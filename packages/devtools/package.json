{
  "name": "@devdogsuga/devtools",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Contributor CLI for DevDogs repositories (the platform monorepo, DogDays, DogPack): the real tools with the session's tier filled in, `setup`, `db sync`, `db types`, `dev-data`, a menu over them, the checks CI runs, and the `with-env` launcher. Ships built JS; run via `pnpm devtools` in a product repo, `pnpm dlx @devdogsuga/devtools` (or the `devtools` bin once installed) from inside a clone.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/DevDogsUGA.git",
    "directory": "packages/devtools"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "devtools": "./bin/devtools.mjs",
    "with-env": "./bin/with-env.mjs"
  },
  "files": [
    "bin",
    "dist",
    "env.ts"
  ],
  "scripts": {
    "build": "tsdown && node scripts/write-build-info.mjs && node ../../scripts/check-bundle-imports.mjs",
    "cli": "node ./bin/devtools.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@dotenvx/dotenvx": "^2.21.0",
    "@sentry/core": "catalog:",
    "@sentry/node": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@yarnpkg/fslib": "^3.1.5",
    "@yarnpkg/shell": "^4.1.3",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "postgres": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/cli-core": "workspace:*",
    "@devdogsuga/config": "workspace:*",
    "@devdogsuga/sdk": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsdown": "^0.23.0",
    "vitest": "catalog:"
  }
}
