{
  "name": "@devdogsuga/cli-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The shared core of the published CLIs (devtools, backstage): repo root and peer loading, ui, telemetry, tier and env entry, env discovery, the env runtime (target table, env-file loading, sessions, with-env), db/run, instance, args and the command catalog. Never published; each CLI inlines it with tsdown, so it is only ever a workspace:* devDependency.",
  "license": "BSD-3-Clause",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@devdogsuga/sdk": "workspace:*",
    "@dotenvx/dotenvx": "^2.21.0",
    "@sentry/node": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@yarnpkg/fslib": "^3.1.5",
    "@yarnpkg/shell": "^4.1.3",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "dotenv": "^18.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
