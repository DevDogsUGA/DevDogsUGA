{
  // Test-only package: no dist, nothing published, nothing else in the
  // workspace imports it. Same repo-relative base as packages/supabase for
  // the same reason documented there — noEmit only, so the ESM/CJS
  // resolution trap that base extends to avoid does not even apply here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
