{
  // Consumers read `src` directly (see `exports`); templates import React
  // explicitly because a loader may select the classic JSX runtime. `scripts`
  // is checked separately (tsconfig.typecheck.json).
  "extends": "@devdogsuga/config/tsconfig/lib.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    // The templates are JSX but nothing here ever mounts: Satori consumes the
    // plain {type, props} objects the automatic runtime produces. `react-jsx`
    // keeps React out of every template's import list.
    "jsx": "react-jsx",
    "types": ["node"],
    "rootDir": "src"
  },
  "include": ["src"],
  // Tests are typechecked (tsconfig.typecheck.json includes them) but never
  // bundled: the platform consumes `src` directly, and a test file in the
  // Worker graph is dead weight that still has to be parsed.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
