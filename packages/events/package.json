{
  "name": "@devdogsuga/events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Config-as-code for the club's meetings and workshops: the Zod schema, the publishability validator, and the authored data itself",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDogsUGA/Backstage.git",
    "directory": "packages/events"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "devdogs-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./imports": {
      "types": "./dist/imports/index.d.ts",
      "devdogs-source": "./src/imports/index.ts",
      "default": "./dist/imports/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:events": "tsx src/check.ts",
    "codegen": "tsx src/write-schemas.ts && prettier --write src/data/*.schema.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devdogsuga/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
