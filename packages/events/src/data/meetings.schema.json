{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^(\\d{4}-\\d{2}-\\d{2})(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$",
            "description": "The meeting's identity and its URL on the platform and posters: its Eastern date (YYYY-MM-DD), plus a lowercase descriptor when another meeting shares the date. Unique across the file. Changing it makes a new meeting."
          },
          "series": {
            "description": "The id of a series in series.json. The meeting inherits the series' category, brand, summary, location and building, and its title is derived from the series unless one is authored.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "description": "The heading on the events page and newsletter card. Always wins over the series-derived title; required for a one-off (no series).",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "description": "About two sentences, for the events card. Defaults to the series' summary.",
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "category": {
            "description": "What the night is. Defaults to the series' category; required for a one-off.",
            "type": "string",
            "enum": [
              "build",
              "workshop",
              "social",
              "info",
              "study",
              "milestone"
            ]
          },
          "brand": {
            "description": "devdogs (Cosmic) or gdgc (Paper). Defaults to the series' brand, then devdogs.",
            "type": "string",
            "enum": ["devdogs", "gdgc"]
          },
          "building": {
            "description": "Defaults to the series' building, then null.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DLW",
                  "Driftmier",
                  "Plant Sciences",
                  "Boyd",
                  "MLC",
                  "Science Learning Center",
                  "Science Library",
                  "Poultry Science",
                  "Main Library",
                  "Tate",
                  "Other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "description": "The room, or \"TBA\" until there is one. Defaults to the series' location.",
            "type": "string",
            "minLength": 1
          },
          "startsAt": {
            "type": "string",
            "description": "ISO 8601 instant, e.g. 2026-09-14T22:00:00.000Z (6 PM Eastern)."
          },
          "endsAt": {
            "type": "string",
            "description": "ISO 8601 instant, after startsAt."
          },
          "rsvpUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "An HTTPS RSVP event page, such as Bevy or the Involvement Network."
          },
          "cancelledAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When it was cancelled; null while it is on."
          },
          "cancellationReason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "description": "Shown beside the struck-through row. Needs cancelledAt."
          },
          "countsForCredit": {
            "type": "boolean",
            "description": "Whether checking in earns a star and counts toward EL credit."
          },
          "surveyUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "An outside survey linked after check-in; usually null."
          },
          "questions": {
            "description": "Ids of meeting-scoped questions from questions.json to ask after check-in, in order.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agenda": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "One schedule row's worth. Unique within its meeting: it is the workshop's identity."
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 280
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Shown in the meeting's detail dialog."
                },
                "project": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The work it recommends, in words (\"DogDays & DogPack\")."
                }
              },
              "required": ["title", "description", "project"],
              "additionalProperties": false
            },
            "description": "The workshops running that night."
          }
        },
        "required": [
          "slug",
          "startsAt",
          "endsAt",
          "rsvpUrl",
          "cancelledAt",
          "cancellationReason",
          "countsForCredit",
          "surveyUrl",
          "agenda"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["meetings"],
  "additionalProperties": false,
  "title": "DevDogs meetings",
  "description": "The club's meetings and their workshops (Backstage packages/events)."
}
