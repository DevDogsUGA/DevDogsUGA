{
  // Covers the root-level maintenance scripts (`scripts/*.ts`, run with tsx).
  // Every app/package has its own tsconfig.json, which editors prefer for files
  // inside it; this one exists so `scripts/` isn't left without a project.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2025"],
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
