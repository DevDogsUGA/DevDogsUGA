# .env.example — every declared environment variable, with its documentation.
#
# GENERATED by `pnpm devtools env example`. Do not edit this file: edit
# the owning manifest (src/env.ts, env.ts, supabase/env.ts) and regenerate.
# CI runs `env example --check` and fails on drift, the same pattern as
# database.types.ts.
#
# One env file per target, each standalone — no shared base, so a key
# missing from a deployed file is a loud validation error rather than a
# silent fallthrough to a development value:
#
#   .env             IS development (the unsuffixed file, read by default)
#   .env.preflight   `pnpm devtools env pull --target preflight`
#   .env.staging     `pnpm devtools env pull --target staging`
#   .env.production  `pnpm devtools env pull --target production`
#
# .env.preflight is a staging area for pushing credentials, never a file an
# app boots from: DEPLOY_ENV=preflight is refused on purpose.
#
# `pnpm devtools setup` (or `pnpm devtools env init`) materialises a
# fresh .env from the same registry that generated this file. The local
# Docker stack is detected by a port probe, not a flag: while it is running,
# .env.generated (written by start-local-stack) overlays the connection
# block — in development only. `supabase stop` is the toggle back.
#
# SECTIONS ARE GROUPED BY WHO READS THE VARIABLE, and two of the readers
# are not apps — that is deliberate, not clutter. The four app sections
# come first. Then `supabase`: values config.toml and the Supabase CLI
# read (the shared auth server serves every app, so no one app can own
# them). Then `devtools`: operator credentials no app reads at all. They
# cannot be moved into an app's manifest, because an app's manifest is
# what `deploy secrets-file` uploads to that app's Worker — filing
# CLOUDFLARE_API_TOKEN or an OAuth client secret under an app would put
# it on an internet-facing Worker that never asked for it. A key an app
# only needs at dev/build time uses the `<app>:tooling` suffix instead,
# which keeps the app grouping without the upload.

# ---------------------------------------------------------------------------
# platform (apps/platform/src/env.ts)
# ---------------------------------------------------------------------------

# Sentry ingest DSN for this app's Sentry project (see
# @devdogsuga/sdk/telemetry). Optional -- empty skips Sentry.init entirely,
# which is the state before the org is onboarded and the state of local
# development. Reaches the Worker like every other environment variable.
# (shared with catalog)
PLATFORM_SENTRY_DSN=""

# Which deployment this is: development, staging, or production. Never written
# into an env file -- wrangler.jsonc's per-env blocks and the build step
# (`DEPLOY_ENV=<tier> pnpm build`) are its two committed sources.
# DEPLOY_ENV=""

# The public URL of the app this manifest belongs to. config.toml reads it as
# auth.site_url, and schedule-builder's daily cron dispatcher fetches its own
# scraper routes through it. Each app defaults to its own localhost port in
# development.
# (shared with supabase)
BASE_URL="http://localhost:3000"

# Bearer token checked by the /api/cron/* routes and cron triggers. One value
# shared across every app in the repo; deployed environments require at least
# 32 characters.
CRON_SECRET=""

# HMAC key for rotating attendance QR challenges, manual codes, and pending
# OAuth claims. Use a different random value in each environment; changing it
# invalidates outstanding challenges.
ATTENDANCE_TOKEN_SECRET=""

# Root key for the moderation API's per-client signing secrets (Standard
# Webhooks, whsec_...). A client's secret is HMAC(this key, client id and
# secret version), so nothing that signs is stored in the database. Use a
# different random value in each environment; changing it changes every
# client's secret.
MODERATION_SIGNING_KEY=""

# Epoch used for DevDogs id/time math. The default is the club's founding date;
# nothing ever overrides it.
DEVDOGS_EPOCH=""

# The club's Discord guild. One shared guild across every environment -- the
# bots differ by alert channel, not by guild.
DISCORD_GUILD_ID="1231994798165069987"

# Verifies Discord interaction signatures on the slash-command endpoint.
# Per-bot, so per-environment.
DISCORD_PUBLIC_KEY=""

# The Discord bot token, for role sync and slash commands.
DISCORD_TOKEN=""

# The Discord forum channel the docs support widget posts into (#tech-support
# in production). Empty turns the widget off.
DISCORD_SUPPORT_FORUM_ID=""

# A webhook on DISCORD_SUPPORT_FORUM_ID. Visitor messages go through it so they
# carry the visitor's name instead of the bot's. Required whenever
# DISCORD_SUPPORT_FORUM_ID is set.
DISCORD_SUPPORT_WEBHOOK_URL=""

# Turnstile secret for the support widget's guest check. Empty deployed means
# guests cannot post; signed-in members still can.
TURNSTILE_SECRET_KEY=""

# Id of the read-only GitHub App (devdogs-platform; a staging twin per
# environment) that feeds merged pull requests to platform.contributions. Used
# by the backfill to mint installation tokens.
GH_APP_ID=""

# The GitHub App's private key (PEM, PKCS#8 or PKCS#1; literal \n sequences are
# accepted). Signs the short-lived JWT the backfill exchanges for an
# installation token.
GH_APP_PRIVATE_KEY=""

# The GitHub App's webhook secret. Verifies X-Hub-Signature-256 on POST
# /github/webhook; without it that route answers 503.
GH_WEBHOOK_SECRET=""

# The GitHub organization the platform links to (docs source links, the account
# page). Any non-empty placeholder is enough to run the app locally.
GITHUB_ORG="DevDogsUGA"

# The Supabase project's base URL. Supplied by .env.generated when the local
# stack is running, and mirrored into NEXT_PUBLIC_SUPABASE_URL for the browser.
# (the running local Supabase stack supplies this via .env.generated)
API_URL="https://$PROJECT_REF.supabase.co"

# Postgres connection string -- the session pooler (port 5432), NOT the
# transaction pooler: drizzle-kit relies on prepared statements the transaction
# pooler does not support and hangs instead of erroring. Also read by the RLS
# persona suite, which falls back to the local default when unset -- a stale
# value here is ignored rather than pointed at a real database. ⚠️ In
# .env.preflight this must be the migration_planner role -- SELECT on
# supabase_migrations.schema_migrations and nothing else -- NEVER the full
# connection string. That file feeds an environment `main` can read, and
# nothing can detect a full string pasted here: the dry run works, push
# succeeds, audit stays green.
# (the running local Supabase stack supplies this via .env.generated)
DB_URL="postgresql://postgres.$PROJECT_REF:<password>@<host>:5432/postgres"

# The Supabase publishable (anon) API key. Safe in a browser -- Row Level
# Security is what protects the data -- and mirrored into
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. Dashboard: Settings > API.
# (the running local Supabase stack supplies this via .env.generated)
PUBLISHABLE_KEY=""

# The PostgREST endpoint: API_URL plus /rest/v1.
# (the running local Supabase stack supplies this via .env.generated)
REST_URL="https://$PROJECT_REF.supabase.co/rest/v1"

# Access-key id for the Storage S3 protocol (Settings > Storage > S3
# Connection). Half of a credential pair, so stored beside its secret.
# (the running local Supabase stack supplies this via .env.generated)
S3_PROTOCOL_ACCESS_KEY_ID=""

# Secret half of the Storage S3 credential pair.
# (the running local Supabase stack supplies this via .env.generated)
S3_PROTOCOL_ACCESS_KEY_SECRET=""

# Storage S3 region -- us-east-1 in production, us-east-2 in staging.
# (the running local Supabase stack supplies this via .env.generated)
S3_PROTOCOL_REGION="us-east-1"

# The Supabase service-role key. Bypasses Row Level Security entirely --
# server-side only, never in any client bundle. Dashboard: Settings > API.
# (the running local Supabase stack supplies this via .env.generated)
SECRET_KEY=""

# The Storage S3 endpoint for the project.
# (the running local Supabase stack supplies this via .env.generated)
STORAGE_S3_URL="https://$PROJECT_REF.storage.supabase.co/storage/v1/s3"

# Set by the framework; never written into an env file.
# NODE_ENV=""

# Browser-side copy of PLATFORM_SENTRY_DSN. Derived -- .env assigns it from
# $PLATFORM_SENTRY_DSN -- so it is never set by hand. Empty skips client-side
# Sentry.init() entirely.
NEXT_PUBLIC_PLATFORM_SENTRY_DSN="$PLATFORM_SENTRY_DSN"

# Browser-side copy of DEPLOY_ENV, for the Sentry `environment` tag on
# client-captured errors. Set alongside DEPLOY_ENV by the build step; defaults
# to development because that is what an unset value means everywhere else in
# this schema.
NEXT_PUBLIC_DEPLOY_ENV="staging"

# Browser-side copy of API_URL. Derived -- .env assigns it from $API_URL -- so
# it is never set by hand.
NEXT_PUBLIC_SUPABASE_URL="$API_URL"

# Browser-side copy of PUBLISHABLE_KEY. Derived -- .env assigns it from
# $PUBLISHABLE_KEY -- so it is never set by hand.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="$PUBLISHABLE_KEY"

# Storage bucket for avatars. The same name in every environment.
NEXT_PUBLIC_AVATARS_BUCKET="avatars"

# Turnstile sitekey for the support widget's guest check. Public by design; it
# only identifies the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ---------------------------------------------------------------------------
# supabase — read by config.toml and the Supabase CLI (supabase/env.ts)
# ---------------------------------------------------------------------------

# The remote Supabase project ref, for supabase link and the derived connection
# URLs. Appears in every project URL, so an identifier, not a secret. Found
# under Project Settings in the Supabase dashboard, like the rest of the
# remote-project block.
PROJECT_REF=""

# Password for the Postgres postgres role, for non-interactive supabase link /
# db push. Leave UNSET unless running remote commands -- an empty value makes
# the CLI fail with ProjectConfigParseError (it even breaks `gen types`).
# SUPABASE_DB_PASSWORD=""

# BASE_URL plus /auth/callback. Its own variable because the CLI substitutes
# env() only when it is the entire value, never inside a larger string.
BASE_URL_CALLBACK="$BASE_URL/auth/callback"

# OAuth client id for the Discord provider in config.toml. Unset disables the
# provider locally; an EMPTY value makes the Supabase CLI fail with
# ProjectConfigParseError.
# DISCORD_CLIENT_ID=""

# OAuth client secret for the Discord provider in config.toml. Unset disables
# the provider locally.
# DISCORD_CLIENT_SECRET=""

# OAuth client id for the GitHub provider in config.toml. Unset disables the
# provider locally; an EMPTY value makes the Supabase CLI fail with
# ProjectConfigParseError.
# GH_CLIENT_ID=""

# OAuth client secret for the GitHub provider in config.toml. Unset disables
# the provider locally.
# GH_CLIENT_SECRET=""

# OAuth client id for the Google provider in config.toml. Unset disables the
# provider locally; an EMPTY value makes the Supabase CLI fail with
# ProjectConfigParseError.
# GOOGLE_CLIENT_ID="000000000000-xxxx.apps.googleusercontent.com"

# OAuth client secret for the Google provider in config.toml. Unset disables
# the provider locally.
# GOOGLE_CLIENT_SECRET=""

# OAuth client id for the LinkedIn provider in config.toml. Unset disables the
# provider locally; an EMPTY value makes the Supabase CLI fail with
# ProjectConfigParseError.
# LINKEDIN_CLIENT_ID=""

# OAuth client secret for the LinkedIn provider in config.toml. Unset disables
# the provider locally.
# LINKEDIN_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# devtools — operator tooling, no app reads these (@devdogsuga/devtools)
# ---------------------------------------------------------------------------

# Unlocks every Bitwarden Secrets Manager project, so it must never reach a
# remote store: never IN one of those projects (a key locked inside the box it
# opens), never synced to GitHub (would hand CI every secret we hold) -- push
# refuses it by name. Lives on the operator's own machine: this file (the
# prompt offers to save it here) or their Password Manager vault.
# BWS_ACCESS_TOKEN=""

# A Supabase personal access token, carrying full account privileges across
# both Supabase organizations. Only `supabase config push` needs it -- the one
# mutation with no dry run -- so in GitHub it reaches the production
# environment only, behind required reviewers.
# SUPABASE_ACCESS_TOKEN=""

# Deploys Workers and sets bindings; only devops hold it. Deploy scripts must
# check for it first and exit naming who to ask, rather than falling into
# wrangler's interactive browser OAuth.
# CLOUDFLARE_API_TOKEN=""

# The Cloudflare account the Workers live in. Wrangler honors this public
# identifier in the environment; each app's wrangler config pins the same value
# so scoped deploy tokens never need account discovery. Identifies, does not
# authorize — every capability is the token's.
CLOUDFLARE_ACCOUNT_ID="61d185ff419ef7bd5bd4b3d314081a49"

# A Sentry organization auth token. Deploys use it to create each release and
# upload its source maps, and the smoke test uses it to confirm the release
# landed. One token serves every environment.
# SENTRY_AUTH_TOKEN=""

# A Sentry internal integration token with Alerts: Read & Write and nothing
# else. The production deploy uses it to delete the Crons monitors an app no
# longer declares, which would otherwise alert on missed check-ins forever.
# SENTRY_MONITORS_TOKEN=""

# The Sentry organization slug the release step and smoke test address.
# Identifies, does not authorize.
SENTRY_ORG="devdogsuga"

# The Bitwarden organization id, needed since the Secrets Manager SDK replaced
# the bws binary (2026-08-19): every SDK call addresses the org explicitly, and
# nothing in its surface discovers it from the token. A public UUID -- it is in
# the Secrets Manager URL (bitwarden.com/#/sm/<org-id>/...) -- that identifies
# and does not authorize. Leave it unset and the first Secrets Manager command
# asks, then saves it here.
# BWS_ORG_ID=""

# One machine's VPN IP, for testing on a phone over VPN (the HMR origin).
# Meaningless to anyone else, so never pushed anywhere.
# DEV_VPN_HOST=""

# Which development database this machine uses when .env names a remote DB_URL:
# local (the Docker stack) or remote (that DB_URL). Written by the first-run
# question in with-env and devtools when you choose "Remember my decision";
# delete it to be asked again. An exported DEV_DB, or --tier
# development:local|remote, wins.
# DEV_DB=""

# Any non-empty value skips env-schema validation, for builds that run without
# secrets -- CI and Docker. Never set it locally: it turns misconfiguration
# from a build error into a runtime surprise.
# SKIP_ENV_VALIDATION=""

# Set to "0" to opt out of devtools' Sentry error reporting (on by default in
# published builds). See src/telemetry.ts.
# DEVTOOLS_TELEMETRY=""
