# Root shared environment for the DevDogs monorepo.
#
# Copy this file to ".env" (gitignored) and fill in the values. This root
# ".env" holds everything shared across apps + everything the Supabase CLI
# needs to read `packages/sb/supabase/config.toml` (ports, auth providers,
# site_url). Apps read it via the `with-env` wrapper; per-app secrets that
# should override a shared value can go in that app's own ".env.local".
#
# REMOTE-FIRST: by default `pnpm dev` and `pnpm sb <cmd>` target the linked
# remote Supabase project (fill in the "Remote Supabase project" section).
# For the local Docker stack instead, run `pnpm sb start-local-stack` (writes
# ".env.supabase") and use the ":local" script variants.

# ---------------------------------------------------------------------------
# Remote Supabase project (Project Settings in the Supabase dashboard)
# ---------------------------------------------------------------------------
PROJECT_REF=""
# Password for the Postgres `postgres` role — needed for non-interactive
# `supabase link` / `supabase db push`. IMPORTANT: leave this UNSET (commented
# out) unless you're running remote commands — an EMPTY value makes the
# Supabase CLI fail with `ProjectConfigParseError` (e.g. breaks `gen types`).
# SUPABASE_DB_PASSWORD="your-db-password"

# Settings > API
API_URL="https://$PROJECT_REF.supabase.co"
PUBLISHABLE_KEY=""
SECRET_KEY=""
REST_URL="https://$PROJECT_REF.supabase.co/rest/v1"

# Settings > Database — use the "Session pooler" string (port 5432), NOT the
# transaction pooler (6543): drizzle-kit relies on prepared statements the
# transaction pooler doesn't support and will hang instead of erroring.
DB_URL="postgresql://postgres.$PROJECT_REF:<password>@<host>:5432/postgres"

# Settings > Storage > S3 Connection
STORAGE_S3_URL="https://$PROJECT_REF.storage.supabase.co/storage/v1/s3"
S3_PROTOCOL_REGION="us-east-1"
S3_PROTOCOL_ACCESS_KEY_ID=""
S3_PROTOCOL_ACCESS_KEY_SECRET=""

# ---------------------------------------------------------------------------
# Local Supabase stack ports (used only by `pnpm sb start-local-stack`)
# ---------------------------------------------------------------------------
SB_API_PORT="54321"
SB_DB_PORT="54322"
SB_DB_SHADOW_PORT="54320"
SB_DB_POOLER_PORT="54329"
SB_STUDIO_PORT="54323"
SB_INBUCKET_PORT="54324"

# ---------------------------------------------------------------------------
# Auth (read by config.toml AND by the apps' OAuth flows — must live here)
# ---------------------------------------------------------------------------
# Canonical site URL: config.toml's auth.site_url. This is the platform app's
# public URL. Other apps pass explicit redirectTo + are listed in
# additional_redirect_urls via SCHEDULE_BUILDER_URL.
BASE_URL="http://localhost:3000"
SCHEDULE_BUILDER_URL="http://localhost:3001"

# OAuth providers. IMPORTANT: leave a provider UNSET (commented out) to disable
# it locally. An EMPTY value ("") for an enabled provider makes the Supabase
# CLI fail with `ProjectConfigParseError`. Uncomment + fill to enable one.
# DISCORD_CLIENT_ID="..."
# DISCORD_CLIENT_SECRET="..."
# GITHUB_CLIENT_ID="..."
# GITHUB_CLIENT_SECRET="..."
# GOOGLE_CLIENT_ID="000000000000-xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# LINKEDIN_CLIENT_ID="..."
# LINKEDIN_CLIENT_SECRET="..."

# ---------------------------------------------------------------------------
# Client-side Supabase (don't change — derived from API_URL / PUBLISHABLE_KEY)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=$API_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$PUBLISHABLE_KEY
NEXT_PUBLIC_AVATARS_BUCKET="avatars"
NEXT_PUBLIC_FEEDBACK_BUCKET="feedback-attachments"
