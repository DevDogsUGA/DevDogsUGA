# Root environment for the DevDogs monorepo — the SINGLE .env for every app.
#
# Copy this file to ".env" (gitignored) and fill in the values, or run
# `pnpm setup` to seed it. There are no per-app .env files: this one root
# ".env" holds everything shared across apps, every app-specific secret, AND
# everything the Supabase CLI needs to read `packages/sb/supabase/config.toml`
# (ports, auth providers, site_url).
#
# Apps load it via dotenvx — scripts run `dotenvx run -f ../../.env -- <cmd>`.
# The ":local" script variants prepend `-f ../../.env.generated` (the
# generated local-stack creds), which win over ".env" (first file wins).
#
# REMOTE-FIRST: by default `pnpm dev` and `pnpm sb <cmd>` target the linked
# remote Supabase project (fill in the "Remote Supabase project" section).
# For the local Docker stack instead, run `pnpm sb link` (writes
# ".env.generated") and use the ":local" script variants.
#
# `pnpm sb` is a dispatcher over four commands -- link, push, reset, status --
# and three targets: --local (the default), --remote, and --team <slug>.
# Everything else in packages/sb is still a package script, e.g.
# `pnpm --filter @devdogsuga/sb generate-types`.

# ---------------------------------------------------------------------------
# Remote Supabase project (Project Settings in the Supabase dashboard)
# ---------------------------------------------------------------------------
PROJECT_REF=""
# Password for the Postgres `postgres` role — needed for non-interactive
# `supabase link` / `supabase db push`. IMPORTANT: leave this UNSET (commented
# out) unless you're running remote commands — an EMPTY value makes the
# Supabase CLI fail with `ProjectConfigParseError` (e.g. breaks `gen types`).
# SUPABASE_DB_PASSWORD="your-db-password"

# Settings > API
API_URL="https://$PROJECT_REF.supabase.co"
PUBLISHABLE_KEY=""
SECRET_KEY=""
REST_URL="https://$PROJECT_REF.supabase.co/rest/v1"

# Settings > Database — use the "Session pooler" string (port 5432), NOT the
# transaction pooler (6543): drizzle-kit relies on prepared statements the
# transaction pooler doesn't support and will hang instead of erroring.
#
# Also read by the RLS persona suite (`pnpm --filter @devdogsuga/sb test:rls`),
# which needs a direct connection for the few things PostgREST cannot express --
# DDL, and explicit transactions. Under the ":local" scripts this comes from
# ".env.generated"; the suite falls back to the default local URL if neither is
# set, so a stale value here is silently ignored rather than pointed at a real
# database.
DB_URL="postgresql://postgres.$PROJECT_REF:<password>@<host>:5432/postgres"

# Settings > Storage > S3 Connection
STORAGE_S3_URL="https://$PROJECT_REF.storage.supabase.co/storage/v1/s3"
S3_PROTOCOL_REGION="us-east-1"
S3_PROTOCOL_ACCESS_KEY_ID=""
S3_PROTOCOL_ACCESS_KEY_SECRET=""

# Local Supabase stack ports are hardcoded in packages/sb/supabase/config.toml
# rather than set here — `supabase seed` rejects env() in numeric config fields.

# ---------------------------------------------------------------------------
# Auth (read by config.toml AND by the apps' OAuth flows — must live here)
# ---------------------------------------------------------------------------
# Canonical site URL: config.toml's auth.site_url. This is the platform app's
# public URL. Other apps pass explicit redirectTo + are listed in
# additional_redirect_urls via SCHEDULE_BUILDER_URL.
BASE_URL="http://localhost:3000"
SCHEDULE_BUILDER_URL="http://localhost:3001"
# config.toml's auth.additional_redirect_urls. Separate variables because the
# CLI only substitutes "env(FOO)" when it is the whole value, never inside a
# larger string.
BASE_URL_CALLBACK="$BASE_URL/auth/callback"
SCHEDULE_BUILDER_URL_CALLBACK="$SCHEDULE_BUILDER_URL/auth/callback"

# OAuth providers. IMPORTANT: leave a provider UNSET (commented out) to disable
# it locally. An EMPTY value ("") for an enabled provider makes the Supabase
# CLI fail with `ProjectConfigParseError`. Uncomment + fill to enable one.
# DISCORD_CLIENT_ID="..."
# DISCORD_CLIENT_SECRET="..."
# GITHUB_CLIENT_ID="..."
# GITHUB_CLIENT_SECRET="..."
# GOOGLE_CLIENT_ID="000000000000-xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# LINKEDIN_CLIENT_ID="..."
# LINKEDIN_CLIENT_SECRET="..."

# ---------------------------------------------------------------------------
# Client-side Supabase (don't change — derived from API_URL / PUBLISHABLE_KEY)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=$API_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$PUBLISHABLE_KEY
NEXT_PUBLIC_AVATARS_BUCKET="avatars"
NEXT_PUBLIC_FEEDBACK_BUCKET="feedback-attachments"

# ---------------------------------------------------------------------------
# Platform app (apps/platform) — values only this app reads at runtime
# ---------------------------------------------------------------------------
# Cron route auth (Bearer token checked by /api/cron/* and cron triggers).
# Shared with the schedule-builder app below (one value for the whole repo).
CRON_SECRET=""

# Epoch used for DevDogs id/time math
DEVDOGS_EPOCH=""

# Your dev machine's VPN IP, for testing on a phone over VPN (HMR origin).
DEV_VPN_HOST=""

# GitHub organization integration (org invites, team provisioning, rulesets)
#
# Required at boot but only *used* by org invites and team provisioning, so any
# non-empty placeholder is enough to run the platform locally unless you are
# working on those. Same for the Discord block below. This matters because those
# are organization credentials a contributor should not need to hold in order to
# run the console against their own database.
GITHUB_ORG="DevDogsUGA"

# The DevDogs GitHub App replaced an org-owner `ghp_` token. Every GitHub call
# the platform makes is an organization administration action, so the old shape
# meant a compromise of the Worker was an organization takeover.
#
# The id and installation id are NOT secrets -- both appear in any webhook
# payload -- so they are GitHub environment *variables*. The private key IS,
# and it mints installation tokens indefinitely: it lives in the `production`
# Bitwarden project and nowhere else.
#
# Keep the key on ONE line, double-quoted, with \n escapes. The newlines are
# load-bearing; a key that lost them parses as a string and fails to sign.
GITHUB_APP_ID="000000"
GITHUB_APP_INSTALLATION_ID="00000000"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER-NOT-A-REAL-KEY-see-docs-platform-secrets-md\n-----END RSA PRIVATE KEY-----\n"

# Airtable — the officer surface for meetings, competitions and dues.
#
# The base id only. The personal access token is stored in Vault under the name
# "airtable_pat" and never lands here; AIRTABLE_PAT below is a bootstrap-only
# escape hatch for the scaffolding scripts, which run before there is anywhere
# to put a secret. Leave both unset until the base exists — the sync refuses
# with a clear message rather than the app failing to start.
#
# Full setup: docs/platform/airtable-setup.md
AIRTABLE_BASE_ID=""
# AIRTABLE_PAT=""

# Discord bot / interactions (role sync, slash commands)
DISCORD_GUILD_ID="1231994798165069987"
DISCORD_PUBLIC_KEY=""
DISCORD_TOKEN=""
# Channel for operational alerts (currently: the Airtable sync refusing a
# drifted base). Leave EMPTY locally -- an empty value means "do not post", and
# staging shares the club's real Discord guild, so a stray value here reaches
# the officers' channel. Production uses 1532424905193160794.
DISCORD_ALERT_CHANNEL_ID=""

# ---------------------------------------------------------------------------
# Schedule Builder app (apps/schedule-builder)
# ---------------------------------------------------------------------------
# (CRON_SECRET is shared — set once in the Platform section above.)

# Sign-in provider: "devdogs" (platform OAuth server, dev default) or "google"
# (production default). Leave unset to use the per-environment default.
# NEXT_PUBLIC_AUTH_MODE="devdogs"

# "Sign in with DevDogs" custom OAuth provider (dev only; unset to disable).
# Register it against the shared auth instance with @devdogsuga/oauth-setup.
# GoTrue calls the token/userinfo URLs server-side, so they cannot be
# localhost even in local dev.
# OAUTH_CLIENT_ID="..."
# OAUTH_CLIENT_SECRET="..."
# OAUTH_AUTHORIZATION_URL="https://your-provider.example.com/oauth/authorize"
# OAUTH_TOKEN_URL="https://your-provider.example.com/oauth/token"
# OAUTH_USERINFO_URL="https://your-provider.example.com/oauth/userinfo"
