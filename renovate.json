{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // This repo has no other Renovate/Dependabot config to extend (checked at
  // TASK-299 time: no renovate.json, .github/renovate.json5, or
  // .github/dependabot.yml existed anywhere in the tree). So this is scoped
  // deliberately narrow rather than broad-then-restricted: `"enabled": false`
  // at the top level turns Renovate off for every dependency in every
  // manifest it can see, and the one `packageRules` entry below re-enables it
  // for exactly `@devdogsuga/*` — see
  // https://docs.renovatebot.com/key-concepts/scoping/ for this being the
  // documented pattern for "only manage these deps". If this repo ever wants
  // Renovate on anything else (next/react/wrangler/...), that is a deliberate
  // second change, not a side effect of this one.
  "enabled": false,
  "extends": ["config:recommended"],
  "labels": ["dependencies", "backstage"],
  "packageRules": [
    {
      "description": "Every `@devdogsuga/*` package this repo consumes is published from the sibling Backstage repo (see pnpm-workspace.yaml's header comment and CUTOVER.md there). One publish there can touch several of these at once, so they land here as one PR, not one each — including the root `@devdogsuga/devtools` devDependency CI pins exactly, since a devtools release is exactly the kind of publish this exists to catch quickly.",
      "matchPackageNames": ["/^@devdogsuga\\//"],
      "enabled": true,
      "groupName": "Backstage @devdogsuga packages",
      "groupSlug": "devdogsuga-backstage",
      // No release-age gate: `@devdogsuga/*` is a monorepo split across two
      // repos, not a third-party dependency whose maintainers Sloan doesn't
      // control. A publish IS the reviewed change (built and tested in
      // Backstage's own CI first) — deliberately different from this org's
      // `minimumReleaseAgeExclude` list in pnpm-workspace.yaml, which holds
      // ordinary third-party packages back precisely because nobody here
      // vetted the maintainer.
      "minimumReleaseAge": null,
      // Renovate's default for a version already written as an exact pin
      // (no `^`/`~`) — replace it with the new exact version rather than
      // widening it into a range. Listed explicitly (not just relied on as
      // the default) because it is exactly the behavior
      // `@devdogsuga/devtools`'s exact "0.1.0" pin depends on: see that
      // dependency's own comment in package.json for why CI wants a reviewed
      // bump, never a silent range match.
      "rangeStrategy": "replace"
    }
  ]
}
