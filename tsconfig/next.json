{
  // Shared preset for the Next apps (platform, schedule-builder).
  //
  // Kept locally rather than consumed from @devdogsuga/config, and extended
  // by relative path, not by package specifier — see lib.json for both
  // reasons (missing `./tsconfig/*` export upstream, and oxc's extends
  // resolution).
  //
  // Only the path-independent settings live here. `paths`, `include`, and
  // `exclude` resolve against the config file that declares them, so hoisting
  // them would rebase "~/*" onto this tsconfig/ folder; they stay in each app.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }]
  }
}
